<?xml version="1.0" encoding="utf-8"?>
<!-- Movies: the kid taps a poster and it plays on the TV; the parent sets it up. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.tabletos.movies"
    android:versionCode="15"
    android:versionName="1.14">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext only to the host bridge on the private Waydroid network. -->
    <application
        android:label="Movies &amp; TV"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen">

        <activity
            android:name=".MoviesActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
