#!/usr/bin/env bash
# GDM session for the kid. Cage shows exactly one app (Android) full-screen;
# without -s it also refuses VT switching. If Cage ever exits, start it again
# rather than dropping back to a login screen.
#
# If Cage dies right away (it couldn't start its GPU renderer: no usable 3D
# driver, e.g. some NVIDIA cards or a VM without 3D), switch to software
# rendering so the kid gets a picture instead of a black screen.

# Linux-side volume all the way up: Android's own volume (the parent's kid
# volume slider) is then the only one that matters. Left at its default (40%),
# on top of the sound card's, the Dell's speaker was all but silent.
(for _ in $(seq 20); do
   wpctl set-volume @DEFAULT_AUDIO_SINK@ 1.0 2>/dev/null && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && break
   sleep 1
 done) &

fails=0
while true; do
  started=$SECONDS
  cage -d -- /usr/local/bin/tablet-android
  if (( SECONDS - started < 5 )); then
    fails=$((fails + 1))
    if (( fails >= 2 )) && [[ ${WLR_RENDERER:-} != pixman ]]; then
      echo "tablet-kiosk-session: GPU renderer failed; using software rendering" >&2
      export WLR_RENDERER=pixman
    fi
  else
    fails=0
  fi
  sleep 1
done
