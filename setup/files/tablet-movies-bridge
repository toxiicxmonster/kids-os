def kid_volume(percent=None):
    """The kid volume (percent), set first if given: via tablet-volume.path,
    since this service can't reach into Android itself. None if Android
    didn't answer (e.g. not running)."""
    request_id = secrets.token_hex(4)
    with volume_lock:
        (STATE / "volume-request").write_text(f"{request_id} {'get' if percent is None else int(percent)}\n")
        end = time.time() + 25
        while time.time() < end:
            time.sleep(0.3)
            try:
                answer_id, value = (STATE / "volume-status").read_text().split()
            except (FileNotFoundError, ValueError):
                continue
            if answer_id == request_id:
                return int(value) if value.isdigit() else None
    return None


def power_request(action, by="the web page"):
    """Restart or shut down the box (the web page): passed to the root helper
    tablet-power (via its .path unit), which lets a running update finish
    first. Returns its answer ("restarting", "shutting-down",
    "waiting-for-update") or "sent" if it hasn't answered in a few seconds."""
    if action not in ("restart", "shutdown"):
        raise ValueError("action must be restart or shutdown")
    request_id = secrets.token_hex(4)
    (STATE / "power-request").write_text(f"{request_id} {action}\n")
    print(f"power: {action} requested from {by}", flush=True)
    end = time.time() + 5
    while time.time() < end:
        time.sleep(0.3)
        try:
            answer_id, _, result = (STATE / "power-status").read_text().split()
        except (FileNotFoundError, ValueError):
            continue
        if answer_id == request_id:
            return result
    return "sent"


UPDATE_REQUEST, UPDATE_STATUS = STATE / "update-request", STATE / "update-status"


def update_request():
    """Check for updates now (the web page): passed to the root helper
    tablet-update-request (via its .path unit), which runs tablet-update.
    Returns the request id; update_status says how it's going."""
    request_id = secrets.token_hex(4)
    UPDATE_REQUEST.write_text(f"{request_id}\n")
    print("update: check requested from the web page", flush=True)
    return request_id


def update_status():
    """{"id", "at", "state"} of the last check from the web page (state:
    checking, up-to-date, updated, stage-failed, offline, failed), or None."""
    try:
        request_id, at, state = UPDATE_STATUS.read_text().split()[:3]
        return {"id": request_id, "at": int(at), "state": state}
    except (OSError, ValueError):
        return None


DAILY_RESTART_DEFAULT = {"enabled": False, "time": "03:30"}
DAILY_RESTART_LAST = STATE / "daily-restart-last"  # "<epoch> <result>": restarted, skipped-busy
DAILY_RESTART_WINDOW = 3 * 3600  # while the box is in use, keep trying this long, then skip the day


def daily_restart_of(cfg):
    return {**DAILY_RESTART_DEFAULT, **cfg.get("daily_restart", {})}


def daily_restart_status(cfg):
    """The setting, when it next happens and how the last one went (web page)."""
    out = daily_restart_of(cfg)
    try:
        at, result = DAILY_RESTART_LAST.read_text().split()[:2]
        out["last"] = {"at": int(float(at)), "result": result}
    except (OSError, ValueError):
        out["last"] = None
    return out


def set_daily_restart(cfg, body):
    setting = daily_restart_of(cfg)
    if "enabled" in body:
