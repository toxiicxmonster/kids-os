def netflix_id(ref):
    """The title number from a netflix.com/title/<id> link (or the bare number)."""
    found = re.search(r"(?:title/|jbv=|^\s*)(\d{5,10})\b", str(ref))
    if not found:
        raise ValueError("paste the netflix.com/title/... link, or the number at its end")
    return found[1]


def netflix_page(nid):
    """The title's public netflix.com page, read only as far as its show/movie
    marker (the pages are a couple of MB and the end sometimes arrives cut off)."""
    req = urllib.request.Request(f"https://www.netflix.com/title/{nid}",
                                 headers={"User-Agent": UA, "Accept-Language": "en-US"})
    page = b""
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            while len(page) < 8_000_000 and not re.search(rb'"@type":"(TVSeries|Movie)"', page[-300_000:]):
                chunk = r.read(65536)
                if not chunk:
                    break
                page += chunk
    except urllib.error.HTTPError:
        return ""
    except http.client.IncompleteRead as e:
        page += e.partial
    return page.decode(errors="replace")


def add_netflix(cfg, ref):
    """Look the title up on its public netflix.com page and put it on the list."""
    nid = netflix_id(ref)
    key = f"nf{nid}"
    if not any(m["key"] == key for m in cfg["movies"]):
        page = netflix_page(nid)
        meta = lambda prop: html.unescape((re.search(f'property="og:{prop}" content="([^"]*)"', page) or [None, ""])[1])
        title = re.sub(r"^Watch\s+|\s*\|\s*Netflix.*$", "", meta("title")).strip()
        if not title:
            raise ValueError(f"Netflix has no title {nid}")
        cfg["movies"].append({"key": key, "title": title, "kind": "netflix", "thumb": meta("image"),
                              "netflix_type": "series" if '"@type":"TVSeries"' in page else "movie"})
        cfg["movies"].sort(key=lambda m: m["title"].lower())
        save(cfg)
    return key


def remove_item(cfg, key):
    cfg["movies"] = [m for m in cfg["movies"] if m["key"] != key]
    save(cfg)


