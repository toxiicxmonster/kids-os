def system_status():
    """The portal's at-a-glance health check."""
    with lock:
        cfg = load()
    out = {"kid_on_screen": kid_name(active_kid()) if active_kid() else None}
    tv = find_tv(cfg) if cfg.get("tv") else None
    out["tv"] = ({"name": tv.get("location") or tv.get("name"), "power": tv["power"]} if tv
                 else {"name": (cfg.get("tv") or {}).get("name"), "power": None})
    plex = {"linked": "account_token" in cfg, "server": cfg.get("server_name"), "reachable": None}
    if cfg.get("server_url"):
        try:
            fetch(f"{cfg['server_url']}/identity", headers=plex_headers(cfg), timeout=4)
            plex["reachable"] = True
        except OSError:
            plex["reachable"] = False
    out["plex"] = plex
    try:
        stamp, commit, result = LAST_UPDATE.read_text().split(maxsplit=2)
        out["update"] = {"at": int(stamp), "commit": commit, "result": result.strip()}
    except (OSError, ValueError):
        out["update"] = None
    disk = shutil.disk_usage("/")
    out["disk"] = {"free_gb": round(disk.free / 1e9, 1), "total_gb": round(disk.total / 1e9, 1)}
    with open("/proc/uptime") as f:
        out["uptime_hours"] = round(float(f.read().split()[0]) / 3600, 1)
    return out


def kid_volume(percent=None):
    """The kid volume (percent), set first if given: via tablet-volume.path,
    since this service can't reach into Android itself. None if Android
    didn't answer (e.g. not running)."""
    request_id = secrets.token_hex(4)
    with volume_lock:
        (STATE / "volume-request").write_text(f"{request_id} {'get' if percent is None else int(percent)}\n")
        end = time.time() + 25
        while time.time() < end:
            time.sleep(0.3)
            try:
                answer_id, value = (STATE / "volume-status").read_text().split()
            except (FileNotFoundError, ValueError):
                continue
            if answer_id == request_id:
                return int(value) if value.isdigit() else None
    return None


def start(cfg, key):
    item = next((m for m in cfg.get("movies", []) if m["key"] == key), None)
    if not item:
        return {"result": "error", "message": "That isn't on the list."}
    if paused_until(cfg) is not None:
        return {"result": "paused", "message": "Movie time is taking a break."}
    tv = find_tv(cfg)
    if not tv or tv["power"] != "PowerOn":
        return {"result": "tv_off", "message": "The TV is off."}

    if item.get("kind") == "netflix":
        # Opens Netflix straight to the title, from anywhere (even another app).
        q = urllib.parse.urlencode({"contentId": key[2:], "mediaType": item.get("netflix_type", "series")})
        try:
            fetch(f"http://{tv['ip']}:8060/launch/{NETFLIX_ROKU_APP}?{q}", "POST", timeout=10)
        except urllib.error.HTTPError:
            return {"result": "error", "message": "Netflix isn't on the TV."}
        threading.Thread(target=netflix_from_start, args=(tv["ip"],), daemon=True).start()
        return {"result": "playing", "message": "It's starting on the TV!"}

    # Plex on the Roku only plays a command cleanly from a fresh start with a
    # profile picked on its "Who's watching?" screen. Already open, or
    # signed in some other way, it ignores the command or shows that screen
    # over the video. So every play starts Plex over the same way (this also
    # takes the TV out of Netflix or whatever else is on).
    ip = tv["ip"]
    try:
        fetch(f"http://{ip}:8060/keypress/Home", "POST", timeout=5)
        time.sleep(2.5)
        fetch(f"http://{ip}:8060/launch/{PLEX_ROKU_APP}", "POST", timeout=5)
    except urllib.error.HTTPError:
        # Roku "Control by mobile apps" is set to Limited (or Plex is missing).
        return {"result": "plex_closed", "message": "Plex isn't open on the TV."}
    target = None
    for _ in range(25):
        time.sleep(1)
        try:
            target = companion_id(ip)
            break
        except OSError:
            pass
    if not target:
        return {"result": "plex_closed", "message": "Plex isn't open on the TV."}
    time.sleep(4)  # until "Who's watching?" is up
    # OK picks the highlighted profile: the last one used on the TV (Kids).
    fetch(f"http://{ip}:8060/keypress/Select", "POST", timeout=5)
    time.sleep(6)  # signing in

    # A TV show plays one of its episodes, picked at random.
    if item.get("kind") == "show":
        key = pick_episode(cfg, key)
    reset_progress(cfg, key)
    uri = f"server://{cfg['server_id']}/com.plexapp.plugins.library/library/metadata/{key}"
    q = urllib.parse.urlencode({"type": "video", "uri": uri, "shuffle": 0, "repeat": 0, "continuous": 0})
    queue_id = plex_json(cfg, f"{cfg['server_url']}/playQueues?{q}", cfg["server_token"],
                         "POST")["MediaContainer"]["playQueueID"]
    server = urllib.parse.urlparse(cfg["server_url"])
    params = {"key": f"/library/metadata/{key}", "offset": 0, "type": "video",
              "containerKey": f"/playQueues/{queue_id}?own=1&window=200",
              "machineIdentifier": cfg["server_id"], "address": server.hostname,
              "port": server.port or (443 if server.scheme == "https" else 80),
              "protocol": server.scheme, "token": cfg["server_token"]}
    headers = {**plex_headers(cfg), "X-Plex-Target-Client-Identifier": target}
    # Check the TV really is playing, and ask once more if not.
    for attempt in range(2):
        params["commandID"] = next(command_ids)
        fetch(f"http://{ip}:8324/player/playback/playMedia?{urllib.parse.urlencode(params)}",
              headers=headers, timeout=20)
        if wait_for(lambda: roku_player(ip)[0] in ("play", "buffer"), 15):
            break
        print("not playing 15s after asking; asking again", flush=True)
    else:
        return {"result": "error", "message": "The TV didn't start it."}
    threading.Thread(target=rewind_when_playing, args=(cfg, ip, target), daemon=True).start()
    return {"result": "playing", "message": "It's playing on the TV!"}


def roku_player(ip):
    """The Roku's own view of its video player: (state, position in ms), state
    being "play", "pause", "buffer", "close", ...; (None, 0) if it won't say."""
    try:
        info = fetch(f"http://{ip}:8060/query/media-player", timeout=4)
    except OSError:
        return None, 0
    state = re.search(r'<player [^>]*state="(\w+)"', info)
    position = re.search(r"<position>(\d+)", info)
    return (state[1] if state else None), (int(position[1]) if position else 0)


def netflix_from_start(ip):
    """Netflix always resumes where the profile left off. Once it's playing, if
    that's partway in, rewind at full speed (3 presses) until it bottoms out at
    the start, then play. (Rewinding ran 3:05 back to 0:00 within 25 s.)"""
    if not wait_for(lambda: roku_player(ip)[0] == "play", 40):
        return
    time.sleep(2)
    state, ms = roku_player(ip)
    if state != "play" or ms <= 15000:
        return
    for _ in range(3):
        fetch(f"http://{ip}:8060/keypress/Rev", "POST", timeout=5)
        time.sleep(0.4)
    how = rewind_until_start(ip, ms)
    fetch(f"http://{ip}:8060/keypress/Play", "POST", timeout=5)
    print(f"Netflix started {ms // 1000}s in; rewound to the start ({how})", flush=True)


def rewind_until_start(ip, start_ms):
    """Wait out a rewind that's running, watching the Roku's position, and
    return as soon as it reaches the start, so a title 20 s in plays again
    within a couple of seconds and one 30 min in only takes as long as it needs.
    It counts as at the start when the position is under 3 s, or when it went
    down and then stayed put within 15 s of the start. If the Roku never reports
    a moving position, it falls back to the old estimate (~position/5)."""
    deadline = time.time() + min(90, 6 + start_ms / 1000 / 5)
    last, moved, still = start_ms, False, 0
    while time.time() < deadline:
        time.sleep(0.5)
        _, ms = roku_player(ip)
        if not ms and not moved:
            continue  # no answer (or a blank position) before it's moving
        if ms < 3000:
            return f"reached {ms // 1000}s"
        if ms < last:
            moved, still = True, 0
        elif moved and ms == last and ms < 15000:  # a mid-way stall keeps waiting
            still += 1
            if still >= 2:  # a second without moving: stopped at the start
                return f"stopped at {ms // 1000}s"
        last = ms
    return "waited the estimate" if not moved else f"timed out at {last // 1000}s"


def wait_for(check, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if check():
            return True
        time.sleep(1)
    return False


def rewind_when_playing(cfg, ip, target, wait=40):
    """Always from the beginning: Plex may still resume from a saved spot, so
    once it's playing, jump back to the start if it began partway in."""
    end = time.time() + wait
    while time.time() < end:
        time.sleep(1.5)
        state, ms = roku_player(ip)
        if state == "play" and ms:
            if ms > 15000:
                q = urllib.parse.urlencode({"type": "video", "offset": 0, "commandID": next(command_ids)})
                fetch(f"http://{ip}:8324/player/playback/seekTo?{q}", headers={
                    **plex_headers(cfg), "X-Plex-Target-Client-Identifier": target}, timeout=5)
                print(f"started {ms // 1000}s in; rewound to the start", flush=True)
            return


def reset_progress(cfg, key):
    """Clear the saved spot for the Kids profile and the account owner (the
    profiles the TV is usually signed in as), so there's nothing to resume."""
    q = urllib.parse.urlencode({"key": key, "identifier": "com.plexapp.plugins.library",
                                "time": 0, "state": "stopped"})
    for token in (cfg["server_token"], cfg.get("account_token")):
        try:
            fetch(f"{cfg['server_url']}/:/progress?{q}", headers=plex_headers(cfg, token))
        except OSError as e:
            print(f"couldn't reset progress: {e!r}", flush=True)
    return "ok"


# ---- bedtime and daily limits ----------------------------------------------------------

def read_side(path):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, ValueError):
        return {} if path == USAGE else []


def write_side(path, data):
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    os.chmod(tmp, 0o600)
    tmp.replace(path)


def minutes_used(kid, day=None):
    day = day or datetime.date.today().isoformat()
    with side_lock:
        return read_side(USAGE).get(kid, {}).get(day, 0)


def count_usage():
    """Once a minute: a minute of tablet time for the kid on the screen."""
    while True:
        time.sleep(60)
        try:
            kid = active_kid()
            if not kid:
                continue
            today = datetime.date.today()
            with side_lock:
                usage = read_side(USAGE)
                days = usage.setdefault(kid, {})
                days[today.isoformat()] = days.get(today.isoformat(), 0) + 1
                for d in list(days):  # two weeks is plenty
                    if d < (today - datetime.timedelta(days=14)).isoformat():
                        del days[d]
                write_side(USAGE, usage)
        except Exception as e:  # keep counting
            print(f"usage: {e!r}", flush=True)


DEFAULT_SCHEDULE = {"enabled": False, "from": "07:00", "to": "19:30", "daily": 0}


def schedule_of(root, kid):
    return {**DEFAULT_SCHEDULE, **kid_settings(root, kid).get("schedule", {})}


def clock(text):
    hour, minute = (int(x) for x in text.split(":"))
    return datetime.time(hour, minute)


def nice_time(when):
    return when.strftime("%-I:%M %p").lower().replace(":00", "")


def next_start(root, kid):
    """When the kid's tablet time next begins (epoch)."""
    start = clock(schedule_of(root, kid)["from"])
    now = datetime.datetime.now()
    at = datetime.datetime.combine(now.date(), start)
    if at <= now:
        at += datetime.timedelta(days=1)
    return at.timestamp()


def kid_allowed(root, kid):
    """(allowed, message for the kid, minutes left or None if no limit)."""
    own = kid_settings(root, kid)
    now = time.time()
    if own.get("sleep_until", 0) > now:
        return False, f"See you at {nice_time(datetime.datetime.fromtimestamp(own['sleep_until']))}!", 0
    if own.get("extra_until", 0) > now:
        return True, "", int((own["extra_until"] - now) // 60)
    sched = schedule_of(root, kid)
    if not sched["enabled"]:
        return True, "", None
    today = datetime.datetime.now()
    start, end = clock(sched["from"]), clock(sched["to"])
    if not start <= today.time() < end:
        return False, f"See you at {nice_time(datetime.datetime.fromtimestamp(next_start(root, kid)))}!", 0
    left = (datetime.datetime.combine(today.date(), end) - today).seconds // 60
    if sched["daily"]:
        used = minutes_used(kid)
        if used >= sched["daily"]:
            return False, "That's all the tablet for today. See you tomorrow!", 0
        left = min(left, sched["daily"] - used)
    return True, "", left


def set_schedule(root, kid, body):
    sched = schedule_of(root, kid)
    if "enabled" in body:
        sched["enabled"] = bool(body["enabled"])
    for key in ("from", "to"):
        if key in body:
            if not re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", str(body[key])):
                raise ValueError("times look like 07:30")
            sched[key] = body[key]
    if "daily" in body:
        daily = int(body["daily"])
        if not 0 <= daily <= 24 * 60:
            raise ValueError("the daily limit is 0 (none) to 1440 minutes")
        sched["daily"] = daily
    if clock(sched["from"]) >= clock(sched["to"]):
        raise ValueError("the start time must be before the end time")
    kid_settings(root, kid)["schedule"] = sched
    save(root)


def add_history(kid, kind, title):
    with side_lock:
        history = read_side(HISTORY)
        history.append({"t": int(time.time()), "kid": kid, "kind": kind, "title": title})
        write_side(HISTORY, history[-1000:])


WATCH_KINDS = ("movie", "show", "netflix")


def favorites_first(movies, kid, days=30, most=8):
    """The kid's list with their favorites at the front: titles they picked at
    least twice in the last month, most-picked first (at most two rows); the
    rest stay in their usual order, so the list doesn't shuffle around."""
    if not kid:
        return list(movies)
    since = time.time() - days * 86400
    with side_lock:
        events = read_side(HISTORY)
    picks = collections.Counter(e["title"] for e in events
                                if e["kid"] == kid and e["t"] >= since and e["kind"] in WATCH_KINDS)
    favorites = sorted((m for m in movies if picks[m["title"]] >= 2),
                       key=lambda m: (-picks[m["title"]], m["title"].lower()))[:most]
    keys = {m["key"] for m in favorites}
    return favorites + [m for m in movies if m["key"] not in keys]


def week_summary(kid):
    """The last 7 days for the parents' page: tablet minutes per day (and the
    week before, to compare), and what was watched, danced to and opened most."""
    today = datetime.date.today()
    with side_lock:
        usage = read_side(USAGE).get(kid, {})
        events = read_side(HISTORY)
    days = [today - datetime.timedelta(days=n) for n in range(6, -1, -1)]
    since = time.mktime(days[0].timetuple())
    recent = [e for e in events if e["kid"] == kid and e["t"] >= since]
    top = lambda kinds: [{"title": t, "count": n} for t, n in collections.Counter(
        e["title"] for e in recent if e["kind"] in kinds).most_common(5)]
    return {
        "days": [{"date": d.isoformat(), "minutes": usage.get(d.isoformat(), 0)} for d in days],
        "total": sum(usage.get(d.isoformat(), 0) for d in days),
        "prev_total": sum(usage.get((d - datetime.timedelta(days=7)).isoformat(), 0) for d in days),
        "watched": top(WATCH_KINDS),
        "apps": top(("app",)),
        "dances": sum(1 for e in recent if e["kind"] == "dance"),
    }


