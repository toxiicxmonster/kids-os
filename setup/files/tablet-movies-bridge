def youtube_start(ip):
    """YouTube opens on its "Who's watching?" screen (it appears ~15-25 s after
    launch); OK there picks the last-used profile and the song starts. Never OK
    while something plays: on the Roku, OK is pause."""
    deadline = time.time() + 50
    next_ok = time.time() + 14
    while time.time() < deadline:
        state = roku_player(ip)[0]
        if state in ("play", "buffer", "open", "pause"):
            return wait_for(lambda: roku_player(ip)[0] == "play", 25)
        if time.time() >= next_ok:
            roku_key(ip, "Select")
            next_ok = time.time() + 8
        time.sleep(1)
    return False


def start_dance(cfg, ids):
    songs = {song["id"]: song for song in cfg.get("dance", [])}
    queue = [songs[vid] for vid in ids if vid in songs][:DANCE_PARTY_MAX]
    if not queue:
        return {"result": "error", "message": "That song isn't on the list."}
    if paused_until(cfg) is not None:
        return {"result": "paused", "message": "Movie time is taking a break."}
    tv = find_tv(cfg)
    if not tv or tv["power"] != "PowerOn":
        return {"result": "tv_off", "message": "The TV is off."}
    if tv.get("kind") == "lg":
        return lg_start_dance(tv, queue)
    ip = tv["ip"]
    try:
        roku_key(ip, "Home")
        time.sleep(2.5)
        fetch(f"http://{ip}:8060/launch/{YOUTUBE_ROKU_APP}?contentID={queue[0]['id']}&mediaType=movie",
              "POST", timeout=10)
    except urllib.error.HTTPError:
        return {"result": "error", "message": "YouTube isn't on the TV."}
    if not youtube_start(ip):
        return {"result": "error", "message": "The TV didn't start it."}
    threading.Thread(target=dance_watch, args=(ip, queue, generation), daemon=True).start()
    return {"result": "playing", "message": "Let's dance!"}


def dance_watch(ip, queue, mine):
    """Follows a dance party on the TV: ads before a song run on their own
    counter; when the song's counter reaches its length, start the next song.
    After the last one YouTube's own autoplay carries on (the owner's choice)."""
    for index, song in enumerate(queue[:-1]):
        length_ms = (song.get("duration") or 0) * 1000
        give_up = time.time() + (song.get("duration") or 900) + 300  # the song plus room for ads
        # Any of these means the song is over. (YouTube's position stops a few
        # seconds short of the listed length, so don't wait for the exact end.)
        #  - it's within ~4.5 s of its length
        #  - it stopped or paused past 90% of its length
        #  - YouTube started another video after this one ran a minute or more
        #    (autoplay; also how a song without a known length ends)
        previous = 0
        while time.time() < give_up:
            time.sleep(1)
            if generation != mine:
                return  # something else was picked
            if roku_app(ip) != YOUTUBE_ROKU_APP:
                return  # someone left YouTube with the remote
            state, ms = roku_player(ip)
            if length_ms and state == "play" and ms >= length_ms - 4500:
                break
            if length_ms and state in ("pause", "stop", "close") and previous >= length_ms * 0.9:
                break
            if state == "play" and ms + 5000 < previous and previous >= max(60000, length_ms * 0.8):
                break
            if state == "play":
                previous = ms
        else:
            return
        nxt = queue[index + 1]
        # YouTube is already past its profile screen: hand it the next song.
        fetch(f"http://{ip}:8060/input/{YOUTUBE_ROKU_APP}?contentID={nxt['id']}&mediaType=movie", "POST",
              timeout=10)
        if not wait_for(lambda: roku_player(ip)[0] == "play" and roku_player(ip)[1] < 15000, 30):
            roku_key(ip, "Home")
            time.sleep(2.5)
            fetch(f"http://{ip}:8060/launch/{YOUTUBE_ROKU_APP}?contentID={nxt['id']}&mediaType=movie",
                  "POST", timeout=10)
            if not youtube_start(ip):
                return


def tv_now():
    """What the TV is showing, as far as the Roku says, plus what we last put on it."""
    with lock:
        cfg = load()
    tv = find_tv(cfg) if cfg.get("tv") else None
    out = {"tv": None, "last": dict(last_play) or None}
    if tv and tv.get("kind") == "lg":
        with airplay_lock:
            airplay = dict(airplay_now)
        if airplay.get("state"):  # a Plex title we sent over AirPlay
            app, state = "Movies & TV", "play" if airplay["state"] == "playing" else airplay["state"]
            position = int(airplay.get("position") or 0)
        else:
            app, state = lg_now(tv) if tv["power"] == "PowerOn" else (None, None)
