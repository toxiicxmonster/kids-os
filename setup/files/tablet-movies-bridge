def link_poll(cfg):
    link = cfg.get("link")
    if not link:
        return {"linked": "account_token" in cfg}
    pin = plex_json(cfg, f"https://plex.tv/api/v2/pins/{link['id']}", None)
    if pin.get("authToken"):
        cfg["account_token"] = pin["authToken"]
        user = plex_json(cfg, "https://plex.tv/api/v2/user", cfg["account_token"])
        cfg["account"] = user.get("username") or user.get("title")
        cfg.pop("link")
        save(cfg)
    return {"linked": "account_token" in cfg, "account": cfg.get("account")}


def profiles(cfg):
    root = ET.fromstring(fetch("https://plex.tv/api/home/users", headers={
        **plex_headers(cfg, cfg["account_token"]), "Accept": "application/xml"}))
    return [{"id": u.get("id"), "title": u.get("title"), "restricted": u.get("restricted") == "1"}
            for u in root.iter("User")]


def use_profile(cfg, user_id):
    """Switch to a Plex Home profile and get its token for the account's own server."""
    switched = ET.fromstring(fetch(f"https://plex.tv/api/home/users/{user_id}/switch", "POST", {
        **plex_headers(cfg, cfg["account_token"]), "Accept": "application/xml"}))
    profile_token = switched.get("authenticationToken") or switched.get("authToken")
    # The switched token is rejected by the server itself; the per-server access
    # token comes from the resources list fetched with it.
    resources = plex_json(cfg, "https://plex.tv/api/v2/resources?includeHttps=1", profile_token)
    owned = [r for r in plex_json(cfg, "https://plex.tv/api/v2/resources?includeHttps=1", cfg["account_token"])
             if "server" in r.get("provides", "") and r.get("owned")]
    if not owned:
        raise RuntimeError("this Plex account doesn't own a server")
    server = owned[0]
    access = next((r for r in resources if r["clientIdentifier"] == server["clientIdentifier"]), None)
    if not access:
        raise RuntimeError("that profile can't access the server")
    cfg.update(profile_id=user_id, profile=switched.get("title"), server_id=server["clientIdentifier"],
               server_name=server["name"], server_token=access["accessToken"])
    cfg["server_url"] = cfg.get("server_url_override") or pick_connection(cfg, server)
    save(cfg)


def pick_connection(cfg, server):
    """First server address that answers from here (the TV is on the same network)."""
    for conn in sorted(server.get("connections", []), key=lambda c: (c.get("relay", False), c.get("local", False))):
        try:
            fetch(conn["uri"] + "/identity", headers=plex_headers(cfg), timeout=5)
            return conn["uri"]
        except OSError:
            continue
    raise RuntimeError("can't reach the Plex server")


PLEX_TYPES = {"movie": 1, "show": 2}  # Plex library section type -> item type number


def library(cfg, query):
    """Movies and TV shows the profile can see (shows play a random episode)."""
    url, token = cfg["server_url"], cfg["server_token"]
    found = []
    for s in plex_json(cfg, f"{url}/library/sections", token)["MediaContainer"].get("Directory", []):
        if s["type"] not in PLEX_TYPES:
            continue
        params = {"type": PLEX_TYPES[s["type"]]}
        if query:
            params["title"] = query
        items = plex_json(cfg, f"{url}/library/sections/{s['key']}/all?{urllib.parse.urlencode(params)}", token)
        for m in items["MediaContainer"].get("Metadata", []):
            found.append({"key": m["ratingKey"], "title": m["title"], "year": m.get("year"),
                          "rating": m.get("contentRating"), "thumb": m.get("thumb"), "kind": s["type"]})
    found.sort(key=lambda m: m["title"].lower())
    return found[:200]


last_episode = {}  # show key -> episode played last time, to avoid an instant repeat


def show_episodes(cfg, show_key):
    """The show's episode keys, in order (season by season)."""
    episodes = plex_json(cfg, f"{cfg['server_url']}/library/metadata/{int(show_key)}/allLeaves",
                         cfg["server_token"])["MediaContainer"].get("Metadata", [])
    if not episodes:
        raise RuntimeError("that show has no episodes the profile can see")
    return [str(e["ratingKey"]) for e in episodes]


def next_episode(cfg, show_key, episode_key):
    """The episode after that one (after the last: the first), for autoplay."""
    keys = show_episodes(cfg, show_key)
    i = keys.index(str(episode_key)) if str(episode_key) in keys else -1
    episode = keys[(i + 1) % len(keys)]
    last_episode[show_key] = episode
    return episode


def pick_episode(cfg, show_key):
    """A random episode of the show (not the same one as last time, if there's a choice)."""
    keys = show_episodes(cfg, show_key)
    choices = [k for k in keys if k != last_episode.get(show_key)] or keys
    episode = random.choice(choices)
    last_episode[show_key] = episode
    return episode


def poster(cfg, key):
    POSTERS.mkdir(mode=0o700, parents=True, exist_ok=True)
    netflix = key.startswith("nf")
    # ".2": Netflix shows now get real posters, so the old composites are skipped.
    path = POSTERS / (f"nf{int(key[2:])}.2.jpg" if netflix else f"{int(key)}.jpg")
    if not path.exists():
        movie = next((m for m in cfg["movies"] if m["key"] == key), None)
        if not movie or not movie.get("thumb"):
            raise KeyError(key)
        if netflix:
            data = None
            if movie.get("netflix_type") == "series":
                data = tvmaze_poster(movie["title"])
            data = data or netflix_poster(fetch(movie["thumb"], raw=True))
        else:
            q = urllib.parse.urlencode({"width": 400, "height": 600, "minSize": 1, "url": movie["thumb"]})
            data = fetch(f"{cfg['server_url']}/photo/:/transcode?{q}",
                         headers=plex_headers(cfg, cfg["server_token"]), raw=True)
        tmp = path.with_suffix(f".{threading.get_ident()}.tmp")  # posters load in parallel
        tmp.write_bytes(data)
        tmp.replace(path)
        return data
    return path.read_bytes()


def tvmaze_poster(title):
    """A 400x600 poster for a TV show, the same shape and style as Plex's,
    from TVmaze (free, no key; 680x1000 show posters). Only TVmaze's best
    match, and only if its name is close to the title; None if there isn't one."""
    import difflib
    from PIL import Image
    squash = lambda s: re.sub(r"[^a-z0-9]", "", s.lower().replace("’", "'"))
    try:
        hits = json.loads(fetch("https://api.tvmaze.com/search/shows?" +
                                urllib.parse.urlencode({"q": title}), timeout=10))
        show = hits[0]["show"] if hits else None
        image = show and (show.get("image") or {}).get("original")
        if not image or difflib.SequenceMatcher(None, squash(title), squash(show["name"])).ratio() < 0.6:
            print(f"no TVmaze poster for {title!r}", flush=True)
            return None
        art = Image.open(io.BytesIO(fetch(image, raw=True, timeout=15))).convert("RGB")
    except (OSError, ValueError, KeyError, IndexError) as e:
        print(f"TVmaze poster for {title!r} failed: {e!r}", flush=True)
        return None
    scale = max(400 / art.width, 600 / art.height)
    art = art.resize((round(art.width * scale), round(art.height * scale)), Image.LANCZOS)
    left, top = (art.width - 400) // 2, (art.height - 600) // 2
    out = io.BytesIO()
    art.crop((left, top, left + 400, top + 600)).save(out, "JPEG", quality=88)
    return out.getvalue()


def netflix_poster(art):
    """A 400x600 poster from Netflix's wide title art: the art across the middle
    over a blurred, darkened copy of itself, with a Netflix-red strip at the bottom."""
    from PIL import Image, ImageDraw, ImageFilter
    wide = Image.open(io.BytesIO(art)).convert("RGB")
    scale = max(400 / wide.width, 600 / wide.height)
    back = wide.resize((round(wide.width * scale), round(wide.height * scale)))
    left, top = (back.width - 400) // 2, (back.height - 600) // 2
    back = back.crop((left, top, left + 400, top + 600)).filter(ImageFilter.GaussianBlur(18))
    back = Image.blend(back, Image.new("RGB", (400, 600), "black"), 0.35)
    front = wide.resize((400, round(wide.height * 400 / wide.width)))
    back.paste(front, (0, (600 - front.height) // 2))
    ImageDraw.Draw(back).rectangle((0, 588, 400, 600), fill=(229, 9, 20))
    out = io.BytesIO()
    back.save(out, "JPEG", quality=88)
    return out.getvalue()


