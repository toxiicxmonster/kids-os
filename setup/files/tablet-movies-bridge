        jf = cfg["jellyfin"]
        steps[0:0] = [
            ("Jellyfin linked", lambda: f"{jf['user']} on {jf['server_name']} via {jf['url']}"),
            ("Jellyfin answers as that user", lambda: f"{len(jellyfin_library(cfg, ''))} movies and shows"),
            ("Jellyfin titles on the list", lambda: len(jf_items) or "none yet"),
        ]
    if (cfg.get("tv") or {}).get("kind") in OTHER_TVS:
        steps = [s for s in steps if s[0] not in ("Plex open on the TV", "Netflix on the TV")]
        steps += other_check(cfg)
    if (cfg.get("tv") or {}).get("kind") == "lg":
        steps = [s for s in steps if s[0] not in ("Plex open on the TV", "Netflix on the TV")]
        steps.append(("LG TV apps", lambda: lg_apps(cfg["tv"])))
        steps.append(("Plex/Jellyfin on the LG", lambda: "over AirPlay" if cfg["tv"].get("airplay") else
                      "not paired over AirPlay (--lg airplay-pair); falls back to the TV's own app"))
    ok = True
    for name, step in steps:
        try:
            result = step()
        except Exception as e:  # report every step
            result, ok = None, False
            print(f"FAIL  {name}: {e!r}")
            continue
        ok &= result is not None
        print(f"{'ok  ' if result is not None else 'FAIL'}  {name}: {result}")
    return 0 if ok else 1


def main():
    if "--set-pin" in sys.argv:
        # sudo -u tablet-movies tablet-movies-bridge --set-pin 1234
        cfg = load()
        set_portal_pin(cfg, sys.argv[sys.argv.index("--set-pin") + 1])
        raise SystemExit("portal PIN set")
    if "--check" in sys.argv:
        raise SystemExit(check())
    if "--jellyfin" in sys.argv:
        # sudo -u tablet-movies tablet-movies-bridge --jellyfin http://server:8096 kids   (asks the password)
        # sudo -u tablet-movies tablet-movies-bridge --jellyfin off
        args = sys.argv[sys.argv.index("--jellyfin") + 1:]
        cfg = load()
        if args[:1] == ["off"]:
            jellyfin_unlink(cfg)
            raise SystemExit("Jellyfin unlinked")
        if len(args) < 2:
            raise SystemExit("usage: --jellyfin <server address> <user>  |  --jellyfin off")
        import getpass
        password = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else getpass.getpass("Password: ")
        try:
            print(jellyfin_link(cfg, args[0], args[1], password))
        except ValueError as e:
            raise SystemExit(str(e))
        raise SystemExit(0)
    if "--lg" in sys.argv:
        raise SystemExit(lg_cli(sys.argv[sys.argv.index("--lg") + 1:]))
    if "--tv" in sys.argv:
        raise SystemExit(tv_cli(sys.argv[sys.argv.index("--tv") + 1:]))
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    threading.Thread(target=seed_dance, daemon=True).start()
    threading.Thread(target=count_usage, daemon=True).start()
    threading.Thread(target=coloring_starter, daemon=True).start()
    threading.Thread(target=netflix_warm, daemon=True).start()
    threading.Thread(target=daily_restart_watch, daemon=True).start()
    server = http.server.ThreadingHTTPServer(LISTEN, Handler)
    print(f"listening on {LISTEN[0]}:{LISTEN[1]}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
