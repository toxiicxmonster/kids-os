def cooldown_left():
    return max(0, round(PLAY_COOLDOWN - (time.time() - last_started)))


def play(cfg, key, dance=None):
    """A movie/show (key) or Dance songs (a list of video ids) from the kid's
    own lists, under one lockout (and only in their tablet time)."""
    global last_started, generation
    if cooldown_left():
        return {"result": "busy", "message": "The TV is catching up.", "cooldown": cooldown_left()}
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    generation += 1
    result = start_dance(cfg, dance) if dance else start(cfg, key)
    if result["result"] == "playing":
        last_started = time.time()
        result["cooldown"] = PLAY_COOLDOWN
        if dance:
            songs = {song["id"]: song["title"] for song in cfg.get("dance", [])}
            title, kind = ", ".join(songs.get(v, v) for v in dance), "dance"
        else:
            item = next((m for m in cfg.get("movies", []) if m["key"] == key), {})
            title, kind = item.get("title", key), item.get("kind") or "movie"
        last_play.update(title=title, kind=kind, kid=kid, at=int(time.time()))
        if kid:
            add_history(kid, kind, title)
    return result


