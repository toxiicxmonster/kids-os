# ---- config -------------------------------------------------------------------

def load():
    try:
        return json.loads(CONFIG.read_text())
    except (FileNotFoundError, ValueError):
        return {"client_id": "kidsos-" + uuid.uuid4().hex[:16], "movies": []}


def kid_users():
    """The kids (kidsos-kids), oldest account first; just "kid" if there's no group."""
    try:
        members = grp.getgrnam(KIDS_GROUP).gr_mem
    except KeyError:
        members = []
    accounts = []
    for name in members:
        try:
            accounts.append(pwd.getpwnam(name))
        except KeyError:
            pass
    return [a.pw_name for a in sorted(accounts, key=lambda a: a.pw_uid)] or ["kid"]


def kid_name(user):
    try:
        return (pwd.getpwnam(user).pw_gecos.split(",")[0] or user).strip()
    except KeyError:
        return user


def kid_settings(root, kid):
    """One kid's own part of the config: their lists (a new kid starts with a
    copy of the first kid's, or of the lists from before there were several
    kids), schedule and bedtime overrides."""
    kids = root.setdefault("kids", {})
    if kid not in kids:
        first = kids.get(kid_users()[0]) or {key: root.get(key, []) for key in LIST_KEYS}
        kids[kid] = {key: copy.deepcopy(first.get(key, [])) for key in LIST_KEYS}
    for key in LIST_KEYS:
        kids[kid].setdefault(key, [])
    return kids[kid]


class KidView(collections.abc.MutableMapping):
    """The config as one kid sees it: "movies" and "dance" are theirs, the rest shared."""

    def __init__(self, root, kid):
        self.root, self.kid = root, kid
        self.own = kid_settings(root, kid)

    def _home(self, key):
        return self.own if key in LIST_KEYS else self.root

    def __getitem__(self, key):
        return self._home(key)[key]

    def __setitem__(self, key, value):
        self._home(key)[key] = value

    def __delitem__(self, key):
        del self._home(key)[key]

    def __iter__(self):
        return iter(self.root)

    def __len__(self):
        return len(self.root)


def for_kid(cfg, kid):
    kids = kid_users()
    return KidView(cfg, kid if kid in kids else kids[0])


def save(cfg):
    if isinstance(cfg, KidView):
        cfg = cfg.root
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=1))
    os.chmod(tmp, 0o600)
    tmp.replace(CONFIG)


# ---- movie time pause and the approved list -------------------------------------

def paused_until(cfg):
    """None if movie time is on; otherwise "forever" or the epoch time it resumes."""
    until = cfg.get("paused_until")
    if until == "forever" or (isinstance(until, (int, float)) and until > time.time()):
        return until
    return None


def pause_text(until):
    if until is None:
        return "Movie time is on"
    if until == "forever":
        return "Paused until you resume it"
    return "Paused until " + datetime.datetime.fromtimestamp(until).strftime("%-I:%M %p").lower() + (
        "" if datetime.date.fromtimestamp(until) == datetime.date.today() else " tomorrow")


def set_pause(cfg, how):
    if how in (0, "0", None, "resume"):
        cfg.pop("paused_until", None)
    elif how == "forever":
        cfg["paused_until"] = "forever"
    elif how == "tomorrow":
        # The next 7 am: later today if it's the small hours, otherwise tomorrow.
        now = datetime.datetime.now()
        morning = now.replace(hour=MORNING_HOUR, minute=0, second=0, microsecond=0)
        if morning <= now:
            morning += datetime.timedelta(days=1)
        cfg["paused_until"] = morning.timestamp()
    else:
        minutes = int(how)
        if not 1 <= minutes <= 24 * 60:
            raise ValueError("pause must be 1 minute to 24 hours")
        cfg["paused_until"] = time.time() + minutes * 60
    save(cfg)


def tablet_mode(cfg):
    """Movies & TV and Dance play on the tablet itself (in the kid's own Plex
    and YouTube Kids apps, when they're installed) while the TV is paused or
    no TV is set up; otherwise everything goes to the TV."""
    return paused_until(cfg) is not None or not cfg.get("tv")


