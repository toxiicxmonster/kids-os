def load():
    try:
        return json.loads(CONFIG.read_text())
    except (FileNotFoundError, ValueError):
        return {"client_id": "kidsos-" + uuid.uuid4().hex[:16], "movies": []}


def kid_users():
    """The kids (kidsos-kids), oldest account first; just "kid" if there's no group."""
    try:
        members = grp.getgrnam(KIDS_GROUP).gr_mem
    except KeyError:
        members = []
    accounts = []
    for name in members:
        try:
            accounts.append(pwd.getpwnam(name))
        except KeyError:
            pass
    return [a.pw_name for a in sorted(accounts, key=lambda a: a.pw_uid)] or ["kid"]


def kid_name(user):
    try:
        return (pwd.getpwnam(user).pw_gecos.split(",")[0] or user).strip()
    except KeyError:
        return user


def kid_settings(root, kid):
    """One kid's own part of the config: their lists (a new kid starts with a
    copy of the first kid's, or of the lists from before there were several
    kids), schedule and bedtime overrides."""
    kids = root.setdefault("kids", {})
    if kid not in kids:
        first = kids.get(kid_users()[0]) or {key: root.get(key, []) for key in LIST_KEYS}
        kids[kid] = {key: copy.deepcopy(first.get(key, [])) for key in LIST_KEYS}
    for key in LIST_KEYS:
        kids[kid].setdefault(key, [])
    return kids[kid]


class KidView(collections.abc.MutableMapping):
    """The config as one kid sees it: "movies" and "dance" are theirs, the rest shared."""

    def __init__(self, root, kid):
        self.root, self.kid = root, kid
        self.own = kid_settings(root, kid)

    def _home(self, key):
        return self.own if key in LIST_KEYS else self.root

    def __getitem__(self, key):
        return self._home(key)[key]

    def __setitem__(self, key, value):
        self._home(key)[key] = value

    def __delitem__(self, key):
        del self._home(key)[key]

    def __iter__(self):
        return iter(self.root)

    def __len__(self):
        return len(self.root)


def for_kid(cfg, kid):
    kids = kid_users()
    return KidView(cfg, kid if kid in kids else kids[0])


def save(cfg):
    if isinstance(cfg, KidView):
        cfg = cfg.root
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=1))
    os.chmod(tmp, 0o600)
    tmp.replace(CONFIG)


# ---- movie time pause and the approved list -------------------------------------

def paused_until(cfg):
    """None if movie time is on; otherwise "forever" or the epoch time it resumes."""
    until = cfg.get("paused_until")
    if until == "forever" or (isinstance(until, (int, float)) and until > time.time()):
        return until
    return None


def pause_text(until):
    if until is None:
        return "Movie time is on"
    if until == "forever":
        return "Paused until you resume it"
    return "Paused until " + datetime.datetime.fromtimestamp(until).strftime("%-I:%M %p").lower() + (
        "" if datetime.date.fromtimestamp(until) == datetime.date.today() else " tomorrow")


def set_pause(cfg, how):
    if how in (0, "0", None, "resume"):
        cfg.pop("paused_until", None)
    elif how == "forever":
        cfg["paused_until"] = "forever"
    elif how == "tomorrow":
        # The next 7 am: later today if it's the small hours, otherwise tomorrow.
        now = datetime.datetime.now()
        morning = now.replace(hour=MORNING_HOUR, minute=0, second=0, microsecond=0)
        if morning <= now:
            morning += datetime.timedelta(days=1)
        cfg["paused_until"] = morning.timestamp()
    else:
        minutes = int(how)
        if not 1 <= minutes <= 24 * 60:
            raise ValueError("pause must be 1 minute to 24 hours")
        cfg["paused_until"] = time.time() + minutes * 60
    save(cfg)


def tablet_mode(cfg):
    """Movies & TV and Dance play on the tablet itself (in the kid's own Plex
    and YouTube Kids apps, when they're installed) while the TV is paused or
    no TV is set up; otherwise everything goes to the TV."""
    return paused_until(cfg) is not None or not cfg.get("tv")


def play_local(cfg, key=None, song=None):
    """A pick to watch on the tablet: checks it's allowed and on the kid's list.
    A Plex title gets a stream for Movies & TV's own player (a show: one of
    its episodes, at random); a Dance song is opened in YouTube Kids by the
    app. Nothing goes to the TV."""
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    if not tablet_mode(cfg):
        return {"result": "use_tv", "message": "The TV is on duty: play it there."}
    if song is not None:
        found = next((s for s in cfg.get("dance", []) if s["id"] == song), None)
        if not found:
            return {"result": "error", "message": "That song isn't on the list."}
        title, kind, out = found["title"], "dance", {"video": song}
    else:
        item = next((m for m in cfg.get("movies", []) if m["key"] == key), None)
        if not item:
            return {"result": "error", "message": "That isn't on the list."}
        kind = item.get("kind") or "movie"  # entries from before shows have no kind
        if kind not in PLEX_TYPES:
            return {"result": "tv_only", "message": "That one only plays on the TV."}
        play_key = pick_episode(cfg, key) if kind == "show" else key
        title = item["title"]
        sid = stream_start(play_key, show=key if kind == "show" else None)
        out = {"stream": f"hls/{sid}/start.m3u8", "title": title, "kind": kind}
    if kid:
        add_history(kid, kind, title)
    return {"result": "ok", **out}


def stream_next(cfg, sid):
    """The tablet's player came to the end of an episode: a stream of the
    show's next one, while the kid may still watch here; else "done" (back to
    the posters)."""
    stream = streams.get(sid)
    show = stream and stream.get("show")
    if not show:
        return {"result": "done"}
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping"}
    if not tablet_mode(cfg) or not any(m["key"] == show for m in cfg.get("movies", [])):
        return {"result": "done"}
    episode = next_episode(cfg, show, stream["key"])
    stream_stop(cfg, sid)
    print(f"next episode of {show} on the tablet: {episode}", flush=True)
    return {"result": "ok", "stream": f"hls/{stream_start(episode, show=show)}/start.m3u8"}


# ---- Movies & TV's own player: Plex streams through the bridge ---------------------
#
# The tablet never talks to Plex itself (no Plex sign-in in the kid's Android):
# the app plays http://192.168.240.1:8766/api/hls/<session>/start.m3u8, and the
# bridge passes each request on to the server's transcoder, as the kid's
# profile. Plex's playlists use relative links, so the app's player asks the
# bridge for the rest (/api/hls/<session>/session/<id>/base/index.m3u8,
# .../00000.ts) and those go through the same way. Always from the start
# (offset 0), sized for the tablet's screen.

STREAM_MAX_BITRATE = 3000  # kbps: plenty for 1024x768, light on the server
TV_STREAM_SIZE, TV_STREAM_BITRATE = (1920, 1080), 8000  # the same stream sent to an LG over AirPlay
streams = {}  # session id -> {"key", "at", "show" (a show's key, for its next episode),
#                               and for a TV: "size", "bitrate", "client" (its IP)}


def stream_start(key, size=None, bitrate=None, client=None, show=None):
    sid = uuid.uuid4().hex
    now = time.time()
    for old in [s for s, v in streams.items() if now - v["at"] > 6 * 3600]:
        streams.pop(old, None)
    streams[sid] = {"key": str(int(key)), "at": now, "size": size, "bitrate": bitrate, "client": client,
                    "show": show}
    return sid


def tv_stream_request(method, path, client):
    """A TV fetching the stream it was given (only that TV, only that stream)."""
    parts = path.split("/")  # "", "api", "hls", <sid>, ...
    if method != "GET" or len(parts) < 5 or parts[1:3] != ["api", "hls"]:
        return False
    stream = streams.get(parts[3])
    return bool(stream and stream.get("client") == str(client))


def stream_get(cfg, sid, rest):
    """(body, content type) of one HLS request, passed on to the Plex transcoder."""
    stream = streams.get(sid)
    if not stream or ".." in rest or not re.fullmatch(r"[A-Za-z0-9_./-]+", rest):
        raise KeyError(sid)
    base = f"{cfg['server_url']}/video/:/transcode/universal/"
    # Just the token (the bridge's usual JSON Accept header gets a 400 from the transcoder).
    headers = {"X-Plex-Token": cfg["server_token"]}
    if rest == "start.m3u8":
        w, h = stream.get("size") or tablet_screen() or (1024, 768)
        q = {"path": f"/library/metadata/{stream['key']}", "mediaIndex": 0, "partIndex": 0, "protocol": "hls",
             "offset": 0, "fastSeek": 1, "directPlay": 0, "directStream": 1, "directStreamAudio": 0,
             "subtitleSize": 100, "audioBoost": 100, "location": "lan", "session": sid, "copyts": 1,
             "videoResolution": f"{w}x{h}", "maxVideoBitrate": stream.get("bitrate") or STREAM_MAX_BITRATE,
             "X-Plex-Client-Profile-Extra": "add-transcode-target(type=videoProfile&context=streaming"
                                            "&protocol=hls&container=mpegts&videoCodec=h264&audioCodec=aac)",
             # The transcoder wants who's asking in the query, not only in headers.
             "X-Plex-Session-Identifier": sid, "X-Plex-Client-Identifier": cfg["client_id"],
             "X-Plex-Product": "Plex Web", "X-Plex-Platform": "Chrome", "X-Plex-Device": "Android",
             "X-Plex-Token": cfg["server_token"]}
        if stream.get("client"):
            # For a TV (AirPlay): Plex's web profile makes HLS audio MP3, which the
            # LG plays silent; as Plex for Android it's AAC stereo.
            q.update({"X-Plex-Product": "Plex for Android", "X-Plex-Platform": "Android"})
        qs = urllib.parse.urlencode(q)
        if stream.get("started"):
            # The player starting over (after a decoder fix): a fresh transcode, from the start.
            try:
                fetch(f"{base}stop?session={sid}", headers=plex_headers(cfg, cfg["server_token"]), timeout=10)
            except OSError:
                pass
        stream["started"] = True
        # The server only starts a stream it has first been asked to decide on
        # (without this, start.m3u8 is a bare 400).
        fetch(base + "decision?" + qs, headers={"Accept": "application/json"}, timeout=30)
        url = base + "start.m3u8?" + qs
    else:
        url = base + rest
    data = fetch(url, headers=headers, timeout=60, raw=True)
    stream["at"] = time.time()
    if rest.endswith(".m3u8"):
        # Keep every link relative to the bridge (and the token off the tablet).
        data = re.sub(rb"https?://[^\s\"]*?/video/:/transcode/universal/", b"", data)
        data = re.sub(rb"([?&])X-Plex-Token=[^&\s\"]*", rb"\1", data)
        return data, "application/vnd.apple.mpegurl"
    return data, "video/mp2t"


def stream_stop(cfg, sid):
    if streams.pop(sid, None) is not None:
        try:
            fetch(f"{cfg['server_url']}/video/:/transcode/universal/stop?session={sid}",
                  headers=plex_headers(cfg, cfg["server_token"]), timeout=10)
        except OSError:
            pass


def tablet_screen():
    """The kid's screen size, from tablet-screen-size (cached); None if unknown."""
    global screen_size
    if screen_size is None:
        try:
            out = subprocess.run(["/usr/local/bin/tablet-screen-size"], capture_output=True, text=True, timeout=5)
            w, h = re.search(r"(\d+)x(\d+)", out.stdout).groups()
            screen_size = (int(w), int(h))
        except (OSError, AttributeError, subprocess.SubprocessError):
            screen_size = ()
    return screen_size or None


