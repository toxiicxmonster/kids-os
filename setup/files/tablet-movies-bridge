def pin_digest(pin, salt):
    return hashlib.pbkdf2_hmac("sha256", pin.encode(), bytes.fromhex(salt), 200_000).hex()


def set_portal_pin(cfg, pin):
    pin = str(pin)
    if not re.fullmatch(r"\d{4,8}", pin):
        raise ValueError("the PIN must be 4 to 8 digits")
    salt = secrets.token_hex(16)
    cfg["portal_pin"] = {"salt": salt, "hash": pin_digest(pin, salt)}
    cfg["portal_sessions"] = {}  # a new PIN signs out every phone
    save(cfg)


def portal_login(cfg, ip, pin):
    """A new session token, or an error string."""
    failures, locked_until = failed_logins.get(ip, (0, 0))
    if locked_until > time.time():
        return None, "Too many wrong PINs. Try again in a few minutes."
    stored = cfg.get("portal_pin")
    if not stored:
        return None, "No PIN set yet: set one in Movies setup on the tablet (parent mode)."
    if not hmac.compare_digest(pin_digest(str(pin), stored["salt"]), stored["hash"]):
        failures += 1
        failed_logins[ip] = (failures, time.time() + 300 if failures >= 5 else 0)
        return None, "Wrong PIN."
    failed_logins.pop(ip, None)
    token = secrets.token_urlsafe(32)
    sessions = {k: v for k, v in cfg.get("portal_sessions", {}).items() if v > time.time()}
    sessions[hashlib.sha256(token.encode()).hexdigest()] = time.time() + PORTAL_SESSION_DAYS * 86400
    cfg["portal_sessions"] = sessions
    save(cfg)
    return token, None


def portal_session_ok(cfg, token):
    if not token:
        return False
    expires = cfg.get("portal_sessions", {}).get(hashlib.sha256(token.encode()).hexdigest(), 0)
    return expires > time.time()


# ---- HTTP helpers -----------------------------------------------------------------

def fetch(url, method="GET", headers=None, timeout=15, raw=False):
    req = urllib.request.Request(url, method=method, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
    return body if raw else body.decode(errors="replace")


def plex_headers(cfg, token=None):
    h = {"Accept": "application/json", "X-Plex-Product": PRODUCT, "X-Plex-Device-Name": "Kids OS",
         "X-Plex-Client-Identifier": cfg["client_id"]}
    if token:
        h["X-Plex-Token"] = token
    return h


def plex_json(cfg, url, token, method="GET"):
    return json.loads(fetch(url, method, plex_headers(cfg, token)))


