# ---- other TVs: Samsung, Google TV / Android TV, Chromecast, Vizio, Fire TV, Apple TV -----
#
# Built from each platform's documented (or widely used) protocol, but NOT yet
# tried on a real TV of any of these kinds (the README says so); Roku and LG
# above are the tested ones. Each kind has the same few things:
#   - power: "PowerOn" / "PowerOff" (None: can't be reached)
#   - home: back to its home screen (the parents' Stop)
#   - Netflix and YouTube: open the app at the title (Cast queues a dance party)
#   - Plex and Jellyfin: the bridge's own HLS stream (as for the tablet and the
#     LG), sent over Cast (Google TV, Chromecast, Vizio) or AirPlay (Samsung,
#     Apple TV) and followed like the LG's AirPlay; a Fire TV runs the Plex or
#     Jellyfin app instead (Plex Companion / Jellyfin remote control)
#   - "On the TV now" and the volume (a level over Cast, otherwise buttons)
# Helpers: tablet-cast (Cast, the Android TV remote protocol, Vizio SmartCast),
# tablet-airplay (AirPlay, an Apple TV's Companion protocol) and adb (Fire TV).

CAST = os.environ.get("TABLET_CAST", "/usr/local/sbin/tablet-cast")
ADB = os.environ.get("TABLET_ADB", "/usr/bin/adb")
