def load():
    try:
        return json.loads(CONFIG.read_text())
    except (FileNotFoundError, ValueError):
        return {"client_id": "kidsos-" + uuid.uuid4().hex[:16], "movies": []}


def kid_users():
    """The kids (kidsos-kids), oldest account first; just "kid" if there's no group."""
    try:
        members = grp.getgrnam(KIDS_GROUP).gr_mem
    except KeyError:
        members = []
    accounts = []
    for name in members:
        try:
            accounts.append(pwd.getpwnam(name))
        except KeyError:
            pass
    return [a.pw_name for a in sorted(accounts, key=lambda a: a.pw_uid)] or ["kid"]


def kid_name(user):
    try:
        return (pwd.getpwnam(user).pw_gecos.split(",")[0] or user).strip()
    except KeyError:
        return user


def kid_settings(root, kid):
    """One kid's own part of the config: their lists (a new kid starts with a
    copy of the first kid's, or of the lists from before there were several
    kids), schedule and bedtime overrides."""
    kids = root.setdefault("kids", {})
    if kid not in kids:
        first = kids.get(kid_users()[0]) or {key: root.get(key, []) for key in LIST_KEYS}
        kids[kid] = {key: copy.deepcopy(first.get(key, [])) for key in LIST_KEYS}
    for key in LIST_KEYS:
        kids[kid].setdefault(key, [])
    return kids[kid]


class KidView(collections.abc.MutableMapping):
    """The config as one kid sees it: "movies" and "dance" are theirs, the rest shared."""

    def __init__(self, root, kid):
        self.root, self.kid = root, kid
        self.own = kid_settings(root, kid)

    def _home(self, key):
        return self.own if key in LIST_KEYS else self.root

    def __getitem__(self, key):
        return self._home(key)[key]

    def __setitem__(self, key, value):
        self._home(key)[key] = value

    def __delitem__(self, key):
        del self._home(key)[key]

    def __iter__(self):
        return iter(self.root)

    def __len__(self):
        return len(self.root)


def for_kid(cfg, kid):
    kids = kid_users()
    return KidView(cfg, kid if kid in kids else kids[0])


def save(cfg):
    if isinstance(cfg, KidView):
        cfg = cfg.root
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=1))
    os.chmod(tmp, 0o600)
    tmp.replace(CONFIG)


# ---- movie time pause and the approved list -------------------------------------

def paused_until(cfg):
    """None if movie time is on; otherwise "forever" or the epoch time it resumes."""
    until = cfg.get("paused_until")
    if until == "forever" or (isinstance(until, (int, float)) and until > time.time()):
        return until
    return None


def pause_text(until):
    if until is None:
        return "Movie time is on"
    if until == "forever":
        return "Paused until you resume it"
    return "Paused until " + datetime.datetime.fromtimestamp(until).strftime("%-I:%M %p").lower() + (
        "" if datetime.date.fromtimestamp(until) == datetime.date.today() else " tomorrow")


def set_pause(cfg, how):
    if how in (0, "0", None, "resume"):
        cfg.pop("paused_until", None)
    elif how == "forever":
        cfg["paused_until"] = "forever"
    elif how == "tomorrow":
        # The next 7 am: later today if it's the small hours, otherwise tomorrow.
        now = datetime.datetime.now()
        morning = now.replace(hour=MORNING_HOUR, minute=0, second=0, microsecond=0)
        if morning <= now:
            morning += datetime.timedelta(days=1)
        cfg["paused_until"] = morning.timestamp()
    else:
        minutes = int(how)
        if not 1 <= minutes <= 24 * 60:
            raise ValueError("pause must be 1 minute to 24 hours")
        cfg["paused_until"] = time.time() + minutes * 60
    save(cfg)


def tablet_mode(cfg):
    """Movies & TV and Dance play on the tablet itself (in the kid's own Plex
    and YouTube Kids apps, when they're installed) while the TV is paused or
    no TV is set up; otherwise everything goes to the TV."""
    return paused_until(cfg) is not None or not cfg.get("tv")


def play_local(cfg, key=None, song=None):
    """A pick to watch on the tablet: checks it's allowed and on the kid's list.
    A Plex title gets a stream for Movies & TV's own player (a show: one of
    its episodes, at random); a Dance song is opened in YouTube Kids by the
    app. Nothing goes to the TV."""
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    if not tablet_mode(cfg):
        return {"result": "use_tv", "message": "The TV is on duty: play it there."}
    if song is not None:
        found = next((s for s in cfg.get("dance", []) if s["id"] == song), None)
        if not found:
            return {"result": "error", "message": "That song isn't on the list."}
        title, kind, out = found["title"], "dance", {"video": song, "duration": found.get("duration") or 0}
    else:
        item = next((m for m in cfg.get("movies", []) if m["key"] == key), None)
        if not item:
            return {"result": "error", "message": "That isn't on the list."}
        kind = item.get("kind") or "movie"  # entries from before shows have no kind
        if kind not in PLEX_TYPES:
            return {"result": "tv_only", "message": "That one only plays on the TV."}
        play_key = pick_episode(cfg, key) if kind == "show" else key
        title = item["title"]
        sid = stream_start(play_key, show=key if kind == "show" else None)
        out = {"stream": f"hls/{sid}/start.m3u8", "title": title, "kind": kind}
    if kid:
        add_history(kid, kind, title)
    return {"result": "ok", **out}


def stream_next(cfg, sid):
    """The tablet's player came to the end of an episode: a stream of the
    show's next one, while the kid may still watch here; else "done" (back to
    the posters)."""
    stream = streams.get(sid)
    show = stream and stream.get("show")
    if not show:
        return {"result": "done"}
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping"}
    if not tablet_mode(cfg) or not any(m["key"] == show for m in cfg.get("movies", [])):
        return {"result": "done"}
    episode = next_episode(cfg, show, stream["key"])
    stream_stop(cfg, sid)
    print(f"next episode of {show} on the tablet: {episode}", flush=True)
    return {"result": "ok", "stream": f"hls/{stream_start(episode, show=show)}/start.m3u8"}


# ---- Movies & TV's own player: Plex streams through the bridge ---------------------
#
# The tablet never talks to Plex itself (no Plex sign-in in the kid's Android):
# the app plays http://192.168.240.1:8766/api/hls/<session>/start.m3u8, and the
# bridge passes each request on to the server's transcoder, as the kid's
# profile. Plex's playlists use relative links, so the app's player asks the
# bridge for the rest (/api/hls/<session>/session/<id>/base/index.m3u8,
# .../00000.ts) and those go through the same way. Always from the start
# (offset 0), sized for the tablet's screen.

STREAM_MAX_BITRATE = 3000  # kbps: plenty for 1024x768, light on the server
TV_STREAM_SIZE, TV_STREAM_BITRATE = (1920, 1080), 8000  # the same stream sent to an LG over AirPlay
streams = {}  # session id -> {"key", "at", "show" (a show's key, for its next episode),
#                               and for a TV: "size", "bitrate", "client" (its IP)}


def stream_start(key, size=None, bitrate=None, client=None, show=None):
    sid = uuid.uuid4().hex
    now = time.time()
    for old in [s for s, v in streams.items() if now - v["at"] > 6 * 3600]:
        meter_done(streams.pop(old, None))
    streams[sid] = {"key": key if is_jf(key) else str(int(key)), "at": now, "size": size, "bitrate": bitrate, "client": client,
                    "show": show}
    return sid


def tv_stream_request(method, path, client):
    """A TV fetching the stream it was given (only that TV, only that stream)."""
    parts = path.split("/")  # "", "api", "hls", <sid>, ...
    if method != "GET" or len(parts) < 5 or parts[1:3] != ["api", "hls"]:
        return False
    stream = streams.get(parts[3])
    return bool(stream and stream.get("client") == str(client))


def stream_get(cfg, sid, rest, query=""):
    """(body, content type) of one HLS request. A TV's playlists and its first
    few segments go in the journal, with how long each took (AirPlay starts
    that never play: did the TV fetch the video, and how fast?)."""
    stream = streams.get(sid)
    if not stream or not stream.get("client"):
        return stream_fetch(cfg, sid, rest, query)
    began = time.time()
    count = "segments" if rest.endswith(".ts") else "playlists"
    stream[count] = stream.get(count, 0) + 1
    note = stream[count] <= (3 if count == "segments" else 5)
    try:
        body, ctype = stream_fetch(cfg, sid, rest, query)
    except Exception as e:
        print(f"TV stream: {rest.rsplit('/', 1)[-1]} failed after {time.time() - began:.1f} s: {e!r}", flush=True)
        raise
    if note:
        print(f"TV stream: {rest.rsplit('/', 1)[-1]} ({len(body)} bytes) in {time.time() - began:.1f} s", flush=True)
    if count == "playlists" and stream[count] <= 2:
        # What the TV was handed (tokens are already off it), for a TV that
        # takes the playlist and then reports an error without asking for more.
        lines = body.decode("utf-8", "replace").strip().splitlines()
        print("TV stream playlist:\n  " + "\n  ".join(line[:200] for line in lines[:6]), flush=True)
    return body, ctype


def stream_fetch(cfg, sid, rest, query=""):
    """(body, content type) of one HLS request, passed on to the Plex transcoder
    (or Jellyfin's)."""
    stream = streams.get(sid)
    if not stream or ".." in rest or not re.fullmatch(r"[A-Za-z0-9_./-]+", rest):
        raise KeyError(sid)
    if is_jf(stream["key"]):
        return jellyfin_stream_get(cfg, sid, stream, rest, query)
    base = f"{cfg['server_url']}/video/:/transcode/universal/"
    # Just the token (the bridge's usual JSON Accept header gets a 400 from the transcoder).
    headers = {"X-Plex-Token": cfg["server_token"]}
    if rest == "start.m3u8":
        w, h = stream.get("size") or tablet_screen() or (1024, 768)
        q = {"path": f"/library/metadata/{stream['key']}", "mediaIndex": 0, "partIndex": 0, "protocol": "hls",
             "offset": 0, "fastSeek": 1, "directPlay": 0, "directStream": 1, "directStreamAudio": 0,
             "subtitleSize": 100, "audioBoost": 100, "location": "lan", "session": sid, "copyts": 1,
             "videoResolution": f"{w}x{h}", "maxVideoBitrate": stream.get("bitrate") or STREAM_MAX_BITRATE,
             "X-Plex-Client-Profile-Extra": "add-transcode-target(type=videoProfile&context=streaming"
                                            "&protocol=hls&container=mpegts&videoCodec=h264&audioCodec=aac)",
             # The transcoder wants who's asking in the query, not only in headers.
             "X-Plex-Session-Identifier": sid, "X-Plex-Client-Identifier": cfg["client_id"],
             "X-Plex-Product": "Plex Web", "X-Plex-Platform": "Chrome", "X-Plex-Device": "Android",
             "X-Plex-Token": cfg["server_token"]}
        if stream.get("client"):
            # For a TV (AirPlay): Plex's web profile makes HLS audio MP3, which the
            # LG plays silent; as Plex for Android it's AAC stereo.
            q.update({"X-Plex-Product": "Plex for Android", "X-Plex-Platform": "Android"})
            # And always a real transcode: with direct stream, a file's own
            # video was passed through (Toy Story 5: 1924x1040), which the LG
            # took and then refused without fetching a segment.
            q["directStream"] = 0
        qs = urllib.parse.urlencode(q)
        if stream.get("started"):
            # The player starting over (after a decoder fix): a fresh transcode, from the start.
            try:
                fetch(f"{base}stop?session={sid}", headers=plex_headers(cfg, cfg["server_token"]), timeout=10)
            except OSError:
                pass
        stream["started"] = True
        # The server only starts a stream it has first been asked to decide on
        # (without this, start.m3u8 is a bare 400).
        decision = fetch(base + "decision?" + qs, headers={"Accept": "application/json"}, timeout=30)
        url = base + "start.m3u8?" + qs
    else:
        url = base + rest
    data = fetch(url, headers=headers, timeout=60, raw=True)
    stream["at"] = time.time()
    if rest == "start.m3u8" and not data.strip():
        # The transcoder said nothing: its decision says why (a file it can't
        # read, the transcoder failing, no room for its temp files...).
        try:
            mc = json.loads(decision).get("MediaContainer", {})
        except (ValueError, AttributeError):
            mc = {"raw": str(decision)[:300]}
        why = {k: v for k, v in mc.items() if "Decision" in k or k in ("mdeDecision", "raw")}
        print(f"Plex gave an empty playlist for {stream['key']}: {json.dumps(why)[:400]}", flush=True)
        raise RuntimeError("Plex's transcoder didn't start the video")
    if rest.endswith(".ts"):
        meter_feed(stream, data)
    if rest.endswith(".m3u8"):
        # Keep every link relative to the bridge (and the token off the tablet).
        data = re.sub(rb"https?://[^\s\"]*?/video/:/transcode/universal/", b"", data)
        data = re.sub(rb"([?&])X-Plex-Token=[^&\s\"]*", rb"\1", data)
        return data, "application/vnd.apple.mpegurl"
    return data, "video/mp2t"


def jellyfin_stream_get(cfg, sid, stream, rest, query):
    """Jellyfin's HLS: start.m3u8 is its master playlist (h264/aac in MPEG-TS,
    sized for the screen, from the start); its playlists link relatively
    (main.m3u8?..., hls1/main/0.ts?...) with their own query, passed back."""
    jf = cfg["jellyfin"]
    base = f"{jf['url']}/Videos/{jf_id(stream['key'])}/"
    # The token goes in a header, never in a link the tablet (or the TV) sees.
    q = [(k, v) for k, v in urllib.parse.parse_qsl(query) if k.lower() not in ("api_key", "apikey")]
    if rest == "start.m3u8":
        w, h = stream.get("size") or tablet_screen() or (1024, 768)
        if stream.get("started"):
            jellyfin_stream_stop(cfg, sid)  # the player starting over: a fresh transcode
        stream["started"] = True
        q = [("MediaSourceId", jf_id(stream["key"])), ("DeviceId", cfg["client_id"]), ("PlaySessionId", sid),
             ("VideoCodec", "h264"), ("AudioCodec", "aac"), ("TranscodingMaxAudioChannels", "2"),
             ("SegmentContainer", "ts"), ("MaxWidth", str(w)), ("MaxHeight", str(h)),
             ("MaxStreamingBitrate", str((stream.get("bitrate") or STREAM_MAX_BITRATE) * 1000)),
             ("StartTimeTicks", "0"), ("BreakOnNonKeyFrames", "true")]
        rest = "master.m3u8"
    url = base + rest + ("?" + urllib.parse.urlencode(q) if q else "")
    data = fetch(url, headers=jf_auth(cfg, jf["token"]), timeout=60, raw=True)
    stream["at"] = time.time()
    if rest.endswith(".ts"):
        meter_feed(stream, data)
    if rest.endswith(".m3u8"):
        data = re.sub(rb"https?://[^\s\"]*?/Videos/[0-9a-f]{32}/", b"", data)
        data = re.sub(rb"([?&])(?:api_key|ApiKey)=[^&\s\"]*&?", rb"\1", data)
        return data, "application/vnd.apple.mpegurl"
    return data, "video/mp2t"


def jellyfin_stream_stop(cfg, sid):
    try:
        req = urllib.request.Request(
            f"{cfg['jellyfin']['url']}/Videos/ActiveEncodings?"
            + urllib.parse.urlencode({"deviceId": cfg["client_id"], "playSessionId": sid}),
            method="DELETE", headers={"User-Agent": UA, **jf_auth(cfg, cfg["jellyfin"]["token"])})
        urllib.request.urlopen(req, timeout=10).close()
    except (OSError, KeyError):
        pass


def stream_stop(cfg, sid):
    stream = streams.pop(sid, None)
    meter_done(stream)
    if stream is not None and is_jf(stream["key"]):
        jellyfin_stream_stop(cfg, sid)
    elif stream is not None:
        try:
            fetch(f"{cfg['server_url']}/video/:/transcode/universal/stop?session={sid}",
                  headers=plex_headers(cfg, cfg["server_token"]), timeout=10)
        except OSError:
            pass


# ---- evening out loudness: each Plex title measured as it streams -------------------
#
# Plex titles are much quieter than YouTube (measured 2026-11-20: a Bluey
# episode -32 LUFS, Despicable Me -18; YouTube Kids plays songs at -14 to
# -24), and Plex's audioBoost changes nothing. So every stream's segments
# also go through ffmpeg's EBU R128 meter on their way past; at the end the
# title's (and its show's) loudness is kept, and Movies & TV's player boosts
# or softens it toward LOUDNESS_TARGET next time (GET /api/hls-gain/<session>).

LOUDNESS = STATE / "loudness.json"  # Plex key -> {"lufs", "seconds"}
LOUDNESS_TARGET = -18.0  # LUFS: about where YouTube Kids' songs sit
LOUDNESS_RANGE = (-10.0, 12.0)  # dB: the most it softens or boosts
METER_MIN_SECONDS, METER_MAX_SECONDS = 90, 30 * 60
FFMPEG = "/usr/bin/ffmpeg"
loudness_lock = threading.Lock()


class Meter:
    """ffmpeg's loudness meter on one stream's audio, fed segment by segment
    (from a queue, so the player's requests never wait for it)."""

    def __init__(self):
        self.lufs, self.seconds = None, 0.0
        self.chunks = queue.Queue(maxsize=32)
        self.proc = subprocess.Popen([FFMPEG, "-hide_banner", "-nostats", "-loglevel", "info", "-f", "mpegts",
                                      "-i", "pipe:0", "-vn", "-af", "ebur128=framelog=info", "-f", "null", "-"],
                                     stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        threading.Thread(target=self._feed, daemon=True).start()
        threading.Thread(target=self._read, daemon=True).start()

    def _feed(self):
        try:
            while (chunk := self.chunks.get()) is not None:
                self.proc.stdin.write(chunk)
        except (OSError, ValueError):
            pass
        finally:
            try:
                self.proc.stdin.close()
            except OSError:
                pass

    def _read(self):
        # Each line: "... t: 12.3   TARGET:-23 LUFS    M: ... S: ...    I: -20.1 LUFS ..."
        for line in io.TextIOWrapper(self.proc.stderr, errors="replace"):
            t = re.search(r"(?<![A-Za-z])t:\s*([\d.]+)", line)
            i = re.search(r"(?<![A-Za-z])I:\s*(-?[\d.]+) LUFS", line)
            if t and i:
                self.seconds, self.lufs = float(t[1]), float(i[1])

    def feed(self, data):
        if self.seconds >= METER_MAX_SECONDS:
            return False
        try:
            self.chunks.put_nowait(data)
        except queue.Full:
            pass  # (a skipped segment only shortens the measurement)
        return True

    def finish(self):
        self.chunks.put(None)
        try:
            self.proc.wait(20)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        return self.lufs, self.seconds


def meter_feed(stream, data):
    with loudness_lock:  # (the player may ask for two segments at once)
        if "meter" not in stream and not stream.get("stopped"):
            try:
                stream["meter"] = Meter() if os.path.exists(FFMPEG) else None
            except OSError as e:
                print(f"loudness meter: {e!r}", flush=True)
                stream["meter"] = None
        meter = stream.get("meter")
    if meter and not meter.feed(data):
        stream["meter"] = None  # long enough: keep it now
        threading.Thread(target=meter_keep, args=(stream, meter), daemon=True).start()


def meter_done(stream):
    if stream is None:
        return
    with loudness_lock:
        stream["stopped"] = True
        meter = stream.pop("meter", None)
    if meter:
        threading.Thread(target=meter_keep, args=(stream, meter), daemon=True).start()


def meter_keep(stream, meter):
    lufs, seconds = meter.finish()
    if lufs is None or seconds < METER_MIN_SECONDS or lufs < -70:
        return
    with loudness_lock:
        known = read_side(LOUDNESS)
        for key in filter(None, (stream["key"], stream.get("show"))):
            if key == stream["key"] and (known.get(key) or {}).get("seconds", 0) > seconds:
                continue  # a longer measurement of this title already
            known[str(key)] = {"lufs": round(lufs, 1), "seconds": round(seconds)}
        write_side(LOUDNESS, known)
    print(f"loudness: {stream['key']} {lufs:.1f} LUFS over {seconds:.0f}s", flush=True)


def loudness_gain(sid):
    """dB for the player to even this stream out (0 when it isn't known yet)."""
    stream = streams.get(sid)
    if not stream:
        return 0.0
    with loudness_lock:
        known = read_side(LOUDNESS)
    found = known.get(stream["key"]) or known.get(str(stream.get("show") or ""))
    if not found:
        return 0.0
    low, high = LOUDNESS_RANGE
    return round(max(low, min(high, LOUDNESS_TARGET - found["lufs"])), 1)


def tablet_screen():
    """The kid's screen size, from tablet-screen-size (cached); None if unknown."""
    global screen_size
    if screen_size is None:
        try:
            out = subprocess.run(["/usr/local/bin/tablet-screen-size"], capture_output=True, text=True, timeout=5)
            w, h = re.search(r"(\d+)x(\d+)", out.stdout).groups()
            screen_size = (int(w), int(h))
        except (OSError, AttributeError, subprocess.SubprocessError):
            screen_size = ()
    return screen_size or None


screen_size = None


def add_item(cfg, key):
    if is_jf(key):
        if not cfg.get("jellyfin"):
            raise ValueError("Jellyfin isn't linked")
        if not any(m["key"] == key for m in cfg["movies"]):
            item = jf_item(cfg, jf_id(key))
            if item.get("Type") not in JF_TYPES:
                raise KeyError(key)  # only whole movies and shows go on the list
            cfg["movies"].append({"key": key, "title": item["Name"], "year": item.get("ProductionYear"),
                                  "kind": JF_TYPES[item["Type"]], "source": "jellyfin"})
            cfg["movies"].sort(key=lambda m: m["title"].lower())
            save(cfg)
        return
    if not re.fullmatch(r"\d{1,12}", str(key or "")):
        raise ValueError("that isn't a Plex or Jellyfin title")
    if not any(m["key"] == key for m in cfg["movies"]):
        try:
            item = plex_json(cfg, f"{cfg['server_url']}/library/metadata/{int(key)}",
                             cfg["server_token"])["MediaContainer"]["Metadata"][0]
        except urllib.error.HTTPError as e:
            if e.code == 404:
                raise ValueError("Plex doesn't have that title") from e
            raise
        if item.get("type") not in PLEX_TYPES:
            raise KeyError(key)  # only whole movies and shows go on the list
        cfg["movies"].append({"key": key, "title": item["title"], "year": item.get("year"),
                              "thumb": item.get("thumb"), "kind": item["type"]})
        cfg["movies"].sort(key=lambda m: m["title"].lower())
        save(cfg)


def netflix_id(ref):
    """The title number from a netflix.com/title/<id> link (or the bare number)."""
    found = re.search(r"(?:title/|jbv=|^\s*)(\d{5,10})\b", str(ref))
    if not found:
        raise ValueError("paste the netflix.com/title/... link, or the number at its end")
    return found[1]


def netflix_page(nid, full=False):
    """The title's public netflix.com page and the title number it ended up at
    (an episode's link redirects to its show). Read only as far as the
    show/movie marker, unless full (the episode list comes after it); the
    pages are a couple of MB and the end sometimes arrives cut off."""
    req = urllib.request.Request(f"https://www.netflix.com/title/{nid}",
                                 headers={"User-Agent": UA, "Accept-Language": "en-US"})
    page, final = b"", nid
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            final = (re.search(r"/title/(\d+)", r.geturl()) or [None, nid])[1]
            while len(page) < 8_000_000 and (full or not re.search(rb'"@type":"(TVSeries|Movie)"', page[-300_000:])):
                chunk = r.read(65536)
                if not chunk:
                    break
                page += chunk
    except urllib.error.HTTPError:
        return "", nid
    except http.client.IncompleteRead as e:
        page += e.partial
    return page.decode(errors="replace"), final


def add_netflix(cfg, ref):
    """Look the title up on its public netflix.com page and put it on the list
    (an episode's link puts its whole show on the list)."""
    page, nid = netflix_page(netflix_id(ref))
    key = f"nf{nid}"
    if not any(m["key"] == key for m in cfg["movies"]):
        meta = lambda prop: html.unescape((re.search(f'property="og:{prop}" content="([^"]*)"', page) or [None, ""])[1])
        title = re.sub(r"^Watch\s+|\s*\|\s*Netflix.*$", "", meta("title")).strip()
        if not title:
            raise ValueError(f"Netflix has no title {nid}")
        cfg["movies"].append({"key": key, "title": title, "kind": "netflix", "thumb": meta("image"),
                              "netflix_type": "series" if '"@type":"TVSeries"' in page else "movie"})
        cfg["movies"].sort(key=lambda m: m["title"].lower())
        save(cfg)
        if '"@type":"TVSeries"' in page:
            threading.Thread(target=netflix_episodes, args=(nid,), daemon=True).start()
    return key


NETFLIX_EPISODES = STATE / "netflix-episodes.json"  # title number -> {"at", "episodes"}
netflix_episodes_lock = threading.Lock()


def netflix_episodes(nid):
    """A Netflix show's episode numbers, from its public title page (every
    season, though a long season lists only its first episodes there).
    Cached a week; an old list is used if the page can't be read."""
    with netflix_episodes_lock:
        known = read_side(NETFLIX_EPISODES)
        entry = known.get(nid)
        if entry and time.time() - entry["at"] < 7 * 86400:
            return entry["episodes"]
        episodes = []
        for _ in range(3):  # the list is near the end, which often arrives cut off
            try:
                page, _ = netflix_page(nid, full=True)
            except OSError as e:
                print(f"Netflix episodes of {nid}: {e!r}", flush=True)
                continue
            found = list(dict.fromkeys(re.findall(r'"__typename":"Episode","videoId":(\d+)', page)))
            if len(found) > len(episodes):
                episodes = found
            if "</html>" in page:
                break
        if not episodes:
            return entry["episodes"] if entry else []
        known[nid] = {"at": time.time(), "episodes": episodes}
        write_side(NETFLIX_EPISODES, known)
        return episodes


def netflix_warm():
    """Read every listed Netflix show's episodes ahead of the first pick (each
    page takes a few seconds), at start and then daily."""
    while True:
        try:
            cfg = load()
            lists = [cfg.get("movies", [])] + [k.get("movies", []) for k in cfg.get("kids", {}).values()]
            for nid in dict.fromkeys(m["key"][2:] for lst in lists for m in lst
                                     if m.get("kind") == "netflix" and m.get("netflix_type") == "series"):
                netflix_episodes(nid)
        except Exception as e:
            print(f"Netflix episodes: {e!r}", flush=True)
        time.sleep(86400)


def netflix_pick(item, key):
    """What to start for a Netflix pick: (title number, Roku mediaType). A
    show plays a random episode (not the one from last time), like a Plex
    show; a movie, or a show whose episodes can't be read, is the title."""
    nid, media = key[2:], item.get("netflix_type", "series")
    if media != "series":
        return nid, media
    episodes = netflix_episodes(nid)
    if not episodes:
        return nid, media
    choices = [e for e in episodes if e != last_episode.get(key)] or episodes
    episode = random.choice(choices)
    last_episode[key] = episode
    return episode, "episode"


def remove_item(cfg, key):
    cfg["movies"] = [m for m in cfg["movies"] if m["key"] != key]
    save(cfg)


# ---- web portal PIN and sessions ----------------------------------------------------

failed_logins = {}  # client ip -> (failures, locked until)


def pin_digest(pin, salt):
    return hashlib.pbkdf2_hmac("sha256", pin.encode(), bytes.fromhex(salt), 200_000).hex()


def set_portal_pin(cfg, pin):
    pin = str(pin)
    if not re.fullmatch(r"\d{4,8}", pin):
        raise ValueError("the PIN must be 4 to 8 digits")
    salt = secrets.token_hex(16)
    cfg["portal_pin"] = {"salt": salt, "hash": pin_digest(pin, salt)}
    cfg["portal_sessions"] = {}  # a new PIN signs out every phone
    save(cfg)


def portal_login(cfg, ip, pin):
    """A new session token, or an error string."""
    failures, locked_until = failed_logins.get(ip, (0, 0))
    if locked_until > time.time():
        return None, "Too many wrong PINs. Try again in a few minutes."
    stored = cfg.get("portal_pin")
    if not stored:
        return None, "No PIN set yet: set one in Movies setup on the tablet (parent mode)."
    if not hmac.compare_digest(pin_digest(str(pin), stored["salt"]), stored["hash"]):
        failures += 1
        failed_logins[ip] = (failures, time.time() + 300 if failures >= 5 else 0)
        return None, "Wrong PIN."
    failed_logins.pop(ip, None)
    token = secrets.token_urlsafe(32)
    sessions = {k: v for k, v in cfg.get("portal_sessions", {}).items() if v > time.time()}
    sessions[hashlib.sha256(token.encode()).hexdigest()] = time.time() + PORTAL_SESSION_DAYS * 86400
    cfg["portal_sessions"] = sessions
    save(cfg)
    return token, None


def portal_session_ok(cfg, token):
    if not token:
        return False
    expires = cfg.get("portal_sessions", {}).get(hashlib.sha256(token.encode()).hexdigest(), 0)
    return expires > time.time()


# ---- HTTP helpers -----------------------------------------------------------------

def fetch(url, method="GET", headers=None, timeout=15, raw=False):
    req = urllib.request.Request(url, method=method, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
    return body if raw else body.decode(errors="replace")


def plex_headers(cfg, token=None):
    h = {"Accept": "application/json", "X-Plex-Product": PRODUCT, "X-Plex-Device-Name": "Kids OS",
         "X-Plex-Client-Identifier": cfg["client_id"]}
    if token:
        h["X-Plex-Token"] = token
    return h


def plex_json(cfg, url, token, method="GET"):
    return json.loads(fetch(url, method, plex_headers(cfg, token)))


# ---- Plex account, profile and server ---------------------------------------------

def link_start(cfg):
    pin = plex_json(cfg, "https://plex.tv/api/v2/pins", None, "POST")
    cfg["link"] = {"id": pin["id"], "code": pin["code"]}
    save(cfg)
    return {"code": pin["code"], "url": "https://plex.tv/link"}


def link_poll(cfg):
    link = cfg.get("link")
    if not link:
        return {"linked": "account_token" in cfg}
    pin = plex_json(cfg, f"https://plex.tv/api/v2/pins/{link['id']}", None)
    if pin.get("authToken"):
        cfg["account_token"] = pin["authToken"]
        user = plex_json(cfg, "https://plex.tv/api/v2/user", cfg["account_token"])
        cfg["account"] = user.get("username") or user.get("title")
        cfg.pop("link")
        save(cfg)
    return {"linked": "account_token" in cfg, "account": cfg.get("account")}


def profiles(cfg):
    root = ET.fromstring(fetch("https://plex.tv/api/home/users", headers={
        **plex_headers(cfg, cfg["account_token"]), "Accept": "application/xml"}))
    return [{"id": u.get("id"), "title": u.get("title"), "restricted": u.get("restricted") == "1"}
            for u in root.iter("User")]


def use_profile(cfg, user_id):
    """Switch to a Plex Home profile and get its token for the account's own server."""
    switched = ET.fromstring(fetch(f"https://plex.tv/api/home/users/{user_id}/switch", "POST", {
        **plex_headers(cfg, cfg["account_token"]), "Accept": "application/xml"}))
    profile_token = switched.get("authenticationToken") or switched.get("authToken")
    # The switched token is rejected by the server itself; the per-server access
    # token comes from the resources list fetched with it.
    resources = plex_json(cfg, "https://plex.tv/api/v2/resources?includeHttps=1", profile_token)
    owned = [r for r in plex_json(cfg, "https://plex.tv/api/v2/resources?includeHttps=1", cfg["account_token"])
             if "server" in r.get("provides", "") and r.get("owned")]
    if not owned:
        raise RuntimeError("this Plex account doesn't own a server")
    server = owned[0]
    access = next((r for r in resources if r["clientIdentifier"] == server["clientIdentifier"]), None)
    if not access:
        raise RuntimeError("that profile can't access the server")
    cfg.update(profile_id=user_id, profile=switched.get("title"), server_id=server["clientIdentifier"],
               server_name=server["name"], server_token=access["accessToken"])
    cfg["server_url"] = cfg.get("server_url_override") or pick_connection(cfg, server)
    save(cfg)


PLEX_KEYS = ("link", "account_token", "account", "profile_id", "profile", "server_id", "server_name",
             "server_token", "server_url")


def plex_public(cfg):
    return {"linked": "account_token" in cfg, "account": cfg.get("account"), "profile": cfg.get("profile"),
            "server": cfg.get("server_name"), "code": (cfg.get("link") or {}).get("code")}


def plex_unlink(cfg):
    for k in PLEX_KEYS:
        cfg.pop(k, None)
    save(cfg)
    return plex_public(cfg)


def pick_connection(cfg, server):
    """First server address that answers from here (the TV is on the same network)."""
    for conn in sorted(server.get("connections", []), key=lambda c: (c.get("relay", False), c.get("local", False))):
        try:
            fetch(conn["uri"] + "/identity", headers=plex_headers(cfg), timeout=5)
            return conn["uri"]
        except OSError:
            continue
    raise RuntimeError("can't reach the Plex server")


PLEX_TYPES = {"movie": 1, "show": 2}  # Plex library section type -> item type number


def library(cfg, query):
    """Movies and TV shows the Plex profile and the Jellyfin user can see
    (shows play a random episode). One source failing doesn't hide the other."""
    found, errors = [], []
    for name, linked, search in (("Plex", cfg.get("server_token"), plex_library),
                                 ("Jellyfin", cfg.get("jellyfin"), jellyfin_library)):
        if linked:
            try:
                found += search(cfg, query)
            except (OSError, ValueError, KeyError) as e:
                print(f"{name} search: {e!r}", flush=True)
                errors.append(name)
    if errors and not found:
        raise RuntimeError(f"can't reach {' or '.join(errors)}")
    found.sort(key=lambda m: m["title"].lower())
    return found[:300]


def plex_library(cfg, query):
    url, token = cfg["server_url"], cfg["server_token"]
    found = []
    for s in plex_json(cfg, f"{url}/library/sections", token)["MediaContainer"].get("Directory", []):
        if s["type"] not in PLEX_TYPES:
            continue
        params = {"type": PLEX_TYPES[s["type"]]}
        if query:
            params["title"] = query
        items = plex_json(cfg, f"{url}/library/sections/{s['key']}/all?{urllib.parse.urlencode(params)}", token)
        for m in items["MediaContainer"].get("Metadata", []):
            found.append({"key": m["ratingKey"], "title": m["title"], "year": m.get("year"),
                          "rating": m.get("contentRating"), "thumb": m.get("thumb"), "kind": s["type"],
                          "source": "plex"})
    return found[:200]


last_episode = {}  # show key -> episode played last time, to avoid an instant repeat


def show_episodes(cfg, show_key):
    """The show's episode keys, in order (season by season)."""
    if is_jf(show_key):
        return jellyfin_episodes(cfg, show_key)
    episodes = plex_json(cfg, f"{cfg['server_url']}/library/metadata/{int(show_key)}/allLeaves",
                         cfg["server_token"])["MediaContainer"].get("Metadata", [])
    if not episodes:
        raise RuntimeError("that show has no episodes the profile can see")
    return [str(e["ratingKey"]) for e in episodes]


def next_episode(cfg, show_key, episode_key):
    """The episode after that one (after the last: the first), for autoplay."""
    keys = show_episodes(cfg, show_key)
    i = keys.index(str(episode_key)) if str(episode_key) in keys else -1
    episode = keys[(i + 1) % len(keys)]
    last_episode[show_key] = episode
    return episode


def pick_episode(cfg, show_key):
    """A random episode of the show (not the same one as last time, if there's a choice)."""
    keys = show_episodes(cfg, show_key)
    choices = [k for k in keys if k != last_episode.get(show_key)] or keys
    episode = random.choice(choices)
    last_episode[show_key] = episode
    return episode


# ---- Jellyfin (the open-source alternative to Plex) ----------------------------------
#
# Linked with a Jellyfin user's name and password (only the access token is
# kept, in the config, never sent to Android): use the kids' own Jellyfin user,
# so its parental controls apply to what can be searched and added. Its titles
# go on the same lists with keys "jf<item id>", and play like Plex's: on the
# tablet as an HLS stream through the bridge (Movies & TV's player, the
# loudness meter and next-episode all the same), on an LG paired for AirPlay
# the same way, and otherwise in the TV's Jellyfin app (told what to play
# through Jellyfin's remote control API, with a deep link as the fallback).

JF_KEY = re.compile(r"jf[0-9a-f]{32}")
JF_TYPES = {"Movie": "movie", "Series": "show"}
JELLYFIN_ROKU_APP = "592369"
LG_JELLYFIN_APP = "org.jellyfin.webos"


def is_jf(key):
    return bool(JF_KEY.fullmatch(str(key or "")))


def jf_id(key):
    if not is_jf(key):
        raise ValueError("that isn't a Jellyfin title")
    return key[2:]


def jf_auth(cfg, token=None):
    """Jellyfin's Authorization header (who's asking, and the token once linked)."""
    fields = {"Client": PRODUCT, "Device": "Kids OS", "DeviceId": cfg["client_id"], "Version": "1.0"}
    if token:
        fields["Token"] = token
    return {"Authorization": "MediaBrowser " + ", ".join(f'{k}="{v}"' for k, v in fields.items()),
            "Accept": "application/json"}


def jf_json(cfg, path, method="GET", body=None, params=None, timeout=15):
    jf = cfg["jellyfin"]
    url = jf["url"] + path + ("?" + urllib.parse.urlencode(params) if params else "")
    headers = jf_auth(cfg, jf["token"])
    data = None
    if body is not None:
        data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers={"User-Agent": UA, **headers})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        text = r.read().decode(errors="replace")
    return json.loads(text) if text.strip() else {}


def jf_server_url(ref):
    """A server address as typed ("192.168.0.10:8096", "https://jf.example.com/") made into a base URL."""
    ref = str(ref or "").strip().rstrip("/")
    if not ref:
        raise ValueError("type the Jellyfin server's address")
    if not re.match(r"https?://", ref):
        ref = "http://" + ref
    parsed = urllib.parse.urlparse(ref)
    if not parsed.hostname:
        raise ValueError("that isn't a server address")
    if parsed.scheme == "http" and not parsed.port and parsed.path in ("", "/"):
        ref += ":8096"  # Jellyfin's own port
    return ref


def jellyfin_link(cfg, server, username, password):
    """Sign in as a Jellyfin user and keep its token (not the password)."""
    url = jf_server_url(server)
    try:
        info = json.loads(fetch(url + "/System/Info/Public", headers={"Accept": "application/json"}, timeout=8))
    except (OSError, ValueError) as e:
        raise ValueError(f"no Jellyfin server answers at {url}") from e
    req = urllib.request.Request(
        url + "/Users/AuthenticateByName", method="POST",
        data=json.dumps({"Username": str(username or ""), "Pw": str(password or "")}).encode(),
        headers={"User-Agent": UA, "Content-Type": "application/json", **jf_auth(cfg)})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            auth = json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code in (400, 401, 403):
            raise ValueError("Jellyfin didn't accept that name and password") from e
        raise
    cfg["jellyfin"] = {"url": url, "token": auth["AccessToken"], "user_id": auth["User"]["Id"],
                       "user": auth["User"]["Name"], "server_name": info.get("ServerName") or "Jellyfin",
                       "version": info.get("Version")}
    save(cfg)
    return jellyfin_public(cfg)


def jellyfin_unlink(cfg):
    jf = cfg.get("jellyfin")
    if jf:
        try:
            jf_json(cfg, "/Sessions/Logout", "POST", timeout=5)  # the token stops working too
        except OSError:
            pass
        cfg.pop("jellyfin")
        save(cfg)
    return jellyfin_public(cfg)


def jellyfin_public(cfg):
    jf = cfg.get("jellyfin")
    return ({"linked": True, "server": jf["server_name"], "url": jf["url"], "user": jf["user"]} if jf
            else {"linked": False})


def jf_item(cfg, item_id):
    found = jf_json(cfg, "/Items", params={"userId": cfg["jellyfin"]["user_id"], "ids": item_id,
                                           "fields": "ProductionYear,OfficialRating"}).get("Items") or []
    if not found:
        raise ValueError("Jellyfin doesn't have that title (or this user can't see it)")
    return found[0]


def jellyfin_library(cfg, query):
    params = {"userId": cfg["jellyfin"]["user_id"], "includeItemTypes": "Movie,Series", "recursive": "true",
              "fields": "ProductionYear,OfficialRating", "sortBy": "SortName", "limit": 200}
    if query:
        params["searchTerm"] = query
    return [{"key": "jf" + m["Id"], "title": m["Name"], "year": m.get("ProductionYear"),
             "rating": m.get("OfficialRating"), "kind": JF_TYPES[m["Type"]], "source": "jellyfin"}
            for m in jf_json(cfg, "/Items", params=params).get("Items", []) if m.get("Type") in JF_TYPES]


def jellyfin_episodes(cfg, show_key):
    episodes = jf_json(cfg, f"/Shows/{jf_id(show_key)}/Episodes",
                       params={"userId": cfg["jellyfin"]["user_id"]}).get("Items", [])
    if not episodes:
        raise RuntimeError("that show has no episodes this Jellyfin user can see")
    return ["jf" + e["Id"] for e in episodes]


def jellyfin_tv_session(cfg, ip, wait):
    """The TV's Jellyfin app, as a session the bridge's user may control (it
    must be signed in as the same Jellyfin user), within `wait` seconds."""
    end = time.time() + wait
    while True:
        try:
            for s in jf_json(cfg, "/Sessions", params={"controllableByUserId": cfg["jellyfin"]["user_id"],
                                                       "activeWithinSeconds": 120}, timeout=5):
                if (s.get("RemoteEndPoint") or "").split(":")[0] == ip and s.get("SupportsRemoteControl"):
                    return s["Id"]
        except OSError:
            pass
        if time.time() >= end:
            return None
        time.sleep(1.5)


def jellyfin_tv_start(cfg, item, key, tv):
    """A Jellyfin title in the TV's own Jellyfin app (a Roku, or an LG not
    paired for AirPlay): open the app with the title (a deep link), then have
    it play from the start over Jellyfin's remote control. Not tried on a
    real TV yet: the remote control part is Jellyfin's documented API."""
    play_key = pick_episode(cfg, key) if item.get("kind") == "show" else key
    item_id = jf_id(play_key)
    ip, kind = tv["ip"], tv_kind(tv)
    lg = kind == "lg"
    try:
        if lg:
            with lg_session(tv) as s:
                s.launch(LG_JELLYFIN_APP)
        elif kind == "firetv":
            firetv_launch(ip, FIRETV_JELLYFIN)
        elif kind in OTHER_TVS:
            pass  # (no app to open from here: its Jellyfin app must already be open)
        else:
            fetch(f"http://{ip}:8060/keypress/Home", "POST", timeout=5)
            time.sleep(2.5)
            q = urllib.parse.urlencode({"contentId": item_id,
                                        "mediaType": "episode" if play_key != key else "movie"})
            fetch(f"http://{ip}:8060/launch/{JELLYFIN_ROKU_APP}?{q}", "POST", timeout=5)
    except (urllib.error.HTTPError, LGError) as e:
        print(f"Jellyfin on the TV: {e!r}", flush=True)
        return {"result": "plex_closed", "message": "Jellyfin isn't on the TV."}
    session = jellyfin_tv_session(cfg, ip, 30)
    playing = {"lg": lambda: lg_media(tv) in ("play", "buffer", "?"),
               "roku": lambda: roku_player(ip)[0] in ("play", "buffer"),
               "firetv": lambda: firetv_state(ip) in ("play", "buffer")}.get(kind, lambda: True)
    if session:
        for attempt in range(2):
            jf_json(cfg, f"/Sessions/{session}/Playing", "POST",
                    params={"playCommand": "PlayNow", "itemIds": item_id, "startPositionTicks": 0})
            if wait_for(playing, 20):
                return {"result": "playing", "message": "It's playing on the TV!"}
            print("Jellyfin: not playing 20s after asking; asking again", flush=True)
    elif wait_for(playing, 15):  # the deep link alone did it
        return {"result": "playing", "message": "It's playing on the TV!"}
    print(f"Jellyfin on the TV: {'no remote-control session from ' + ip if not session else 'not playing'}",
          flush=True)
    return {"result": "error", "message": "Jellyfin on the TV didn't start it. Is it signed in as the kids' user?"}


def jellyfin_poster(cfg, key):
    """The title's poster from Jellyfin; with none (a show it couldn't match), one
    made from its wide art or its first episode's picture."""
    jf, item_id = cfg["jellyfin"], jf_id(key)
    image = lambda path, **q: fetch(f"{jf['url']}{path}?{urllib.parse.urlencode({'quality': 90, **q})}",
                                    headers=jf_auth(cfg, jf["token"]), raw=True)
    try:
        return image(f"/Items/{item_id}/Images/Primary", fillWidth=400, fillHeight=600)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise
    item = next((m for m in cfg["movies"] if m["key"] == key), {})
    found = poster_lookup(cfg, item.get("title"), item.get("kind"), item.get("year"))
    if found:
        return found
    wide = []
    for kind in ("Backdrop", "Thumb"):
        wide.append(f"/Items/{item_id}/Images/{kind}")
    try:
        wide += [f"/Items/{e[2:]}/Images/Primary" for e in jellyfin_episodes(cfg, key)[:1]]
    except (OSError, ValueError, RuntimeError):
        pass  # a movie
    for path in wide:
        try:
            return netflix_poster(image(path, maxWidth=800), strip=(170, 92, 195))
        except urllib.error.HTTPError:
            continue
    raise KeyError(key)


def poster(cfg, key):
    POSTERS.mkdir(mode=0o700, parents=True, exist_ok=True)
    if is_jf(key):
        path = POSTERS / f"{key}.jpg"
        if not path.exists():
            if not any(m["key"] == key for m in cfg["movies"]):
                raise KeyError(key)
            data = jellyfin_poster(cfg, key)
            tmp = path.with_suffix(f".{threading.get_ident()}.tmp")
            tmp.write_bytes(data)
            tmp.replace(path)
            return data
        return path.read_bytes()
    netflix = key.startswith("nf")
    # ".2": Netflix shows now get real posters, so the old composites are skipped.
    path = POSTERS / (f"nf{int(key[2:])}.2.jpg" if netflix else f"{int(key)}.jpg")
    if not path.exists():
        movie = next((m for m in cfg["movies"] if m["key"] == key), None)
        if not movie:
            raise KeyError(key)
        kind = ("show" if movie.get("netflix_type") == "series" else "movie") if netflix else movie.get("kind")
        if netflix or not movie.get("thumb"):
            data = poster_lookup(cfg, movie["title"], kind, movie.get("year"))
            if not data and netflix and kind == "show":
                data = tvmaze_poster(movie["title"])
            if not data and movie.get("thumb"):
                data = netflix_poster(fetch(movie["thumb"], raw=True))
            if not data:
                raise KeyError(key)
        else:
            q = urllib.parse.urlencode({"width": 400, "height": 600, "minSize": 1, "url": movie["thumb"]})
            data = fetch(f"{cfg['server_url']}/photo/:/transcode?{q}",
                         headers=plex_headers(cfg, cfg["server_token"]), raw=True)
        tmp = path.with_suffix(f".{threading.get_ident()}.tmp")  # posters load in parallel
        tmp.write_bytes(data)
        tmp.replace(path)
        return data
    return path.read_bytes()


# ---- posters from TMDB and OMDb (optional, each with the parents' own free key) ----------
#
# Plex and Jellyfin give their own posters (their servers mostly get them from
# TMDB). These fill the gaps: Netflix titles (their page has only wide art) and
# titles a server has no poster for. TMDB first, then OMDb; the closest-named
# match only. Keys are kept in cfg["posters"], never in a reply.

TMDB_API = "https://api.themoviedb.org/3"
TMDB_IMAGES = "https://image.tmdb.org/t/p/w500"
OMDB_API = "https://www.omdbapi.com/"
POSTER_SOURCES = ("tmdb", "omdb")
POSTER_NAMES = {"tmdb": "TMDB", "omdb": "OMDb"}


def squash_title(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower().replace("’", "'"))


def close_title(a, b):
    import difflib
    return difflib.SequenceMatcher(None, squash_title(a), squash_title(b)).ratio() >= 0.6


def tmdb_json(key, path, params=None):
    """TMDB with either kind of key: a v3 API key (32 hex) or a v4 read access token."""
    headers = {"Accept": "application/json"}
    params = dict(params or {})
    if key.startswith("eyJ"):
        headers["Authorization"] = f"Bearer {key}"
    else:
        params["api_key"] = key
    return json.loads(fetch(f"{TMDB_API}{path}?{urllib.parse.urlencode(params)}", headers=headers, timeout=10))


def tmdb_poster_url(key, title, kind, year=None):
    tv = kind == "show"
    year_param = "first_air_date_year" if tv else "year"
    params = {"query": title, "include_adult": "false"}
    if year:
        params[year_param] = year
    hits = tmdb_json(key, "/search/tv" if tv else "/search/movie", params).get("results") or []
    if not hits and year:  # a year off by one (release vs. listing) is common
        params.pop(year_param)
        hits = tmdb_json(key, "/search/tv" if tv else "/search/movie", params).get("results") or []
    for hit in hits[:5]:
        names = (hit.get("name"), hit.get("original_name")) if tv else (hit.get("title"), hit.get("original_title"))
        if hit.get("poster_path") and any(close_title(title, n) for n in names if n):
            return TMDB_IMAGES + hit["poster_path"]
    return None


def omdb_json(key, params):
    return json.loads(fetch(f"{OMDB_API}?{urllib.parse.urlencode({'apikey': key, **params})}", timeout=10))


def omdb_poster_url(key, title, kind, year=None):
    params = {"t": title, "type": "series" if kind == "show" else "movie"}
    if year:
        params["y"] = year
    hit = omdb_json(key, params)
    if hit.get("Response") != "True" and year:
        hit = omdb_json(key, {k: v for k, v in params.items() if k != "y"})
    poster = hit.get("Poster")
    if hit.get("Response") == "True" and poster and poster != "N/A" and close_title(title, hit.get("Title")):
        return poster
    return None


def poster_lookup(cfg, title, kind, year=None):
    """A 400x600 poster from TMDB or OMDb (whichever has a key and a match), or None."""
    keys = (cfg.root if isinstance(cfg, KidView) else cfg).get("posters") or {}
    if not title or not keys:
        return None
    for source, find in (("tmdb", tmdb_poster_url), ("omdb", omdb_poster_url)):
        if not keys.get(source):
            continue
        try:
            url = find(keys[source], title, kind, year)
            if url:
                print(f"poster for {title!r} from {source.upper()}", flush=True)
                return poster_fit(fetch(url, raw=True, timeout=15))
        except (OSError, ValueError, KeyError) as e:
            print(f"{source.upper()} poster for {title!r} failed: {e!r}", flush=True)
    return None


def poster_fit(data):
    """Any poster image as 400x600 (scaled to cover, centered)."""
    from PIL import Image
    art = Image.open(io.BytesIO(data)).convert("RGB")
    scale = max(400 / art.width, 600 / art.height)
    art = art.resize((round(art.width * scale), round(art.height * scale)), Image.LANCZOS)
    left, top = (art.width - 400) // 2, (art.height - 600) // 2
    out = io.BytesIO()
    art.crop((left, top, left + 400, top + 600)).save(out, "JPEG", quality=88)
    return out.getvalue()


def posters_public(cfg):
    keys = cfg.get("posters") or {}
    return {source: bool(keys.get(source)) for source in POSTER_SOURCES}


def set_poster_keys(cfg, change):
    """{"tmdb": key | null, "omdb": key | null}: each new key is tried first. Titles'
    posters made without it are fetched again."""
    keys = dict(cfg.get("posters") or {})
    for source in POSTER_SOURCES:
        if source not in change:
            continue
        key = change[source]
        if not key:
            keys.pop(source, None)
            continue
        key = str(key).strip()
        if not re.fullmatch(r"[A-Za-z0-9._-]{6,400}", key):
            raise ValueError(f"that doesn't look like {POSTER_NAMES[source]}'s key")
        try:
            if source == "tmdb":
                tmdb_json(key, "/configuration")
            elif omdb_json(key, {"t": "Bambi", "type": "movie"}).get("Error", "").startswith("Invalid API key"):
                raise ValueError("OMDb didn't accept that key")
        except urllib.error.HTTPError as e:
            raise ValueError(f"{POSTER_NAMES[source]} didn't accept that key") from e
        except OSError as e:
            raise ValueError(f"{POSTER_NAMES[source]} can't be reached right now") from e
        keys[source] = key
    if keys:
        cfg["posters"] = keys
    else:
        cfg.pop("posters", None)
    save(cfg)
    for old in POSTERS.glob("*.jpg"):  # Netflix and Jellyfin ones may change; Plex's don't
        if old.name.startswith(("nf", "jf")):
            old.unlink(missing_ok=True)
    return posters_public(cfg)


def tvmaze_poster(title):
    """A 400x600 poster for a TV show, the same shape and style as Plex's,
    from TVmaze (free, no key; 680x1000 show posters). Only TVmaze's best
    match, and only if its name is close to the title; None if there isn't one."""
    try:
        hits = json.loads(fetch("https://api.tvmaze.com/search/shows?" +
                                urllib.parse.urlencode({"q": title}), timeout=10))
        show = hits[0]["show"] if hits else None
        image = show and (show.get("image") or {}).get("original")
        if not image or not close_title(title, show["name"]):
            print(f"no TVmaze poster for {title!r}", flush=True)
            return None
        return poster_fit(fetch(image, raw=True, timeout=15))
    except (OSError, ValueError, KeyError, IndexError) as e:
        print(f"TVmaze poster for {title!r} failed: {e!r}", flush=True)
        return None


def netflix_poster(art, strip=(229, 9, 20)):
    """A 400x600 poster from wide title art (Netflix's, or a Jellyfin title's with no
    poster): the art across the middle over a blurred, darkened copy of itself,
    with a strip at the bottom (Netflix red, Jellyfin purple)."""
    from PIL import Image, ImageDraw, ImageFilter
    wide = Image.open(io.BytesIO(art)).convert("RGB")
    scale = max(400 / wide.width, 600 / wide.height)
    back = wide.resize((round(wide.width * scale), round(wide.height * scale)))
    left, top = (back.width - 400) // 2, (back.height - 600) // 2
    back = back.crop((left, top, left + 400, top + 600)).filter(ImageFilter.GaussianBlur(18))
    back = Image.blend(back, Image.new("RGB", (400, 600), "black"), 0.35)
    front = wide.resize((400, round(wide.height * 400 / wide.width)))
    back.paste(front, (0, (600 - front.height) // 2))
    ImageDraw.Draw(back).rectangle((0, 588, 400, 600), fill=strip)
    out = io.BytesIO()
    back.save(out, "JPEG", quality=88)
    return out.getvalue()


# ---- Roku TVs -----------------------------------------------------------------------

def local_ipv4s():
    out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True)
    for line in out.stdout.splitlines():
        dev, addr = line.split()[1], line.split()[3].split("/")[0]
        if not dev.startswith(("waydroid", "lxcbr", "docker", "virbr")):
            yield addr


def roku_info(ip):
    info = fetch(f"http://{ip}:8060/query/device-info", timeout=3)
    tag = lambda k: (re.search(f"<{k}>(.*?)</{k}>", info) or [None, ""])[1]
    tv = {"ip": ip, "serial": tag("serial-number") or tag("device-id"), "name": tag("user-device-name"),
          "location": tag("user-device-location"), "power": tag("power-mode")}
    try:
        apps = fetch(f"http://{ip}:8060/query/apps", timeout=3)
        tv["plex"] = f'id="{PLEX_ROKU_APP}"' in apps
        tv["netflix"] = f'id="{NETFLIX_ROKU_APP}"' in apps
    except OSError:
        tv["plex"] = tv["netflix"] = None  # app list blocked ("Limited" mobile-app control)
    return tv


def discover_tvs(wait=3.0, others=True):
    """Roku TVs (ECP) and LG webOS TVs (their second-screen service) on the home
    network; with others, every other kind too (SSDP for Samsung and Fire TV,
    the helpers' mDNS scans for Cast and Apple TV)."""
    sts = [b"roku:ecp", LG_SSDP_ST.encode()] + ([SAMSUNG_SSDP_ST.encode(), DIAL_SSDP_ST.encode()] if others else [])
    searches = [(b"M-SEARCH * HTTP/1.1\r\nHost: 239.255.255.250:1900\r\nMan: \"ssdp:discover\"\r\n"
                 b"ST: " + st + b"\r\nMX: 2\r\n\r\n") for st in sts]
    ips = set()
    lg = {}  # ip -> device description URL
    samsung, dial = set(), {}
    scans = {}  # the helpers' results

    def scan(name, cmd):
        try:
            scans[name] = helper_json(cmd, timeout=20)
        except OSError as e:
            print(f"TV scan ({name}): {e}", flush=True)
    threads = [threading.Thread(target=scan, args=(name, cmd), daemon=True)
               for name, cmd in (("cast", [CAST, "discover"]), ("airplay", [AIRPLAY, "scan"]))
               if others and os.access(cmd[0], os.X_OK)]
    for t in threads:
        t.start()
    socks = []
    for addr in local_ipv4s():
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(addr))
        s.bind((addr, 0))
        s.settimeout(0.3)
        for msg in searches:
            s.sendto(msg, ("239.255.255.250", 1900))
        socks.append(s)
    end = time.time() + wait
    while time.time() < end:
        for s in socks:
            try:
                data, peer = s.recvfrom(2048)
            except socket.timeout:
                continue
            low = data.lower()
            st = (re.search(rb"(?im)^st:\s*(\S+)", data) or [b"", b""])[1].lower()
            if st == DIAL_SSDP_ST.encode().lower():
                found = re.search(rb"(?im)^location:\s*(\S+)", data)
                dial[peer[0]] = found[1].decode() if found else None
            elif st == SAMSUNG_SSDP_ST.encode().lower():
                samsung.add(peer[0])
            elif LG_SSDP_ST.encode().lower() in low or b"webos" in low:
                found = re.search(rb"(?im)^location:\s*(\S+)", data)
                lg[peer[0]] = found[1].decode() if found else None
            elif b"roku" in low:
                ips.add(peer[0])
    tvs = []
    for ip in sorted(ips):
        try:
            tvs.append(roku_info(ip))
        except OSError:
            pass
    for ip, location in sorted(lg.items()):
        tvs.append(lg_describe(ip, location))
    if others:
        for t in threads:
            t.join(20)
        tvs += discover_other({tv["ip"] for tv in tvs}, samsung - ips - set(lg), dial, scans.get("cast") or [],
                              scans.get("airplay") or [])
    for tv in tvs:
        tv["label"] = TV_LABELS[tv_kind(tv)]
    return tvs


def find_tv(cfg):
    """The chosen TV's current info, rediscovering it if its address changed."""
    tv = cfg.get("tv")
    if not tv:
        return None
    if tv.get("kind") == "lg":
        return lg_find(tv)
    if tv.get("kind") in OTHER_TVS:
        return other_find(tv)
    try:
        info = roku_info(tv["ip"])
        if info["serial"] == tv["serial"]:
            return info
    except OSError:
        pass
    for info in discover_tvs(others=False):
        if info["serial"] == tv["serial"]:
            with lock:
                fresh = load()
                if fresh.get("tv", {}).get("serial") == info["serial"]:
                    fresh["tv"]["ip"] = info["ip"]
                    save(fresh)
            return info
    return None


def companion_id(ip, timeout=2, port=8324):
    root = ET.fromstring(fetch(f"http://{ip}:{port}/resources", timeout=timeout))
    return root.find("Player").get("machineIdentifier")


def cooldown_left():
    return max(0, round(PLAY_COOLDOWN - (time.time() - last_started)))


def play(cfg, key, dance=None):
    """A movie/show (key) or Dance songs (a list of video ids) from the kid's
    own lists, under one lockout (and only in their tablet time)."""
    global last_started, generation
    if cooldown_left():
        return {"result": "busy", "message": "The TV is catching up.", "cooldown": cooldown_left()}
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    generation += 1
    if paused_until(cfg) is None:
        item = {} if dance else next((m for m in cfg.get("movies", []) if m["key"] == key), {})
        tv_level_before(cfg, "dance" if dance else item.get("kind") or "movie")
    result = start_dance(cfg, dance) if dance else start(cfg, key)
    if result["result"] == "playing":
        last_started = time.time()
        result["cooldown"] = PLAY_COOLDOWN
        if dance:
            songs = {song["id"]: song["title"] for song in cfg.get("dance", [])}
            title, kind = ", ".join(songs.get(v, v) for v in dance), "dance"
        else:
            item = next((m for m in cfg.get("movies", []) if m["key"] == key), {})
            title, kind = item.get("title", key), item.get("kind") or "movie"
        last_play.update(title=title, kind=kind, kid=kid, at=int(time.time()))
        if kid:
            add_history(kid, kind, title)
    return result


# ---- Dance: Danny Go! songs on the TV's YouTube app ----------------------------------

def ytdlp(url):
    """A channel's video list (ids, titles, lengths) in one request: no downloads,
    no per-video lookups."""
    env = {**os.environ, "HOME": str(STATE), "XDG_CACHE_HOME": str(STATE / "cache")}
    out = subprocess.run([YTDLP, "-J", "--no-warnings", "--skip-download", "--flat-playlist", url],
                         capture_output=True, text=True, timeout=180, env=env)
    if out.returncode:
        raise RuntimeError("YouTube didn't answer: " + (out.stderr.strip().splitlines() or ["?"])[-1])
    return json.loads(out.stdout)


def song_title(title):
    """'"Airplane Mode!" Flying Dance ✈️ | Danny Go! Songs for Kids' -> 'Airplane Mode!'"""
    head = title.split(" | ")[0].strip()
    quoted = re.match(r'^["“](.+?)["”]', head)
    return (quoted[1] if quoted else head)[:48]


def dance_channel():
    """The Danny Go! channel's videos (cached for 6 hours)."""
    if time.time() - channel_cache["at"] > 6 * 3600 or not channel_cache["songs"]:
        entries = ytdlp(DANCE_CHANNEL).get("entries") or []
        channel_cache["songs"] = [{"id": e["id"], "title": song_title(e.get("title") or ""),
                                   "full_title": e.get("title"), "duration": int(e["duration"])}
                                  for e in entries if e.get("id") and e.get("duration")]
        channel_cache["at"] = time.time()
    return channel_cache["songs"]


def youtube_id(ref):
    ref = str(ref).strip()
    found = re.search(r"(?:v=|youtu\.be/|shorts/|embed/|live/)([A-Za-z0-9_-]{11})", ref)
    if found:
        return found[1]
    if VIDEO_ID.fullmatch(ref):
        return ref
    raise ValueError("paste a YouTube link (youtube.com/watch?v=... or youtu.be/...)")


def add_song(cfg, ref):
    vid = youtube_id(ref)
    songs = cfg.setdefault("dance", [])
    if not any(song["id"] == vid for song in songs):
        song = next((song for song in dance_channel() if song["id"] == vid), None) or video_info(vid)
        songs.append({k: song[k] for k in ("id", "title", "duration")})
        save(cfg)
    return vid


def video_info(vid):
    """Any YouTube video: its title from YouTube's oEmbed (link preview) service,
    its length from its public page when that has it (else None: dance_watch
    then notices the end by YouTube moving on to another video)."""
    title = None
    try:
        q = urllib.parse.urlencode({"url": f"https://www.youtube.com/watch?v={vid}", "format": "json"})
        title = json.loads(fetch(f"https://www.youtube.com/oembed?{q}")).get("title")
    except urllib.error.HTTPError as e:
        if e.code in (400, 404):
            raise ValueError("YouTube doesn't have that video")
    duration = None
    try:
        page = fetch(f"https://www.youtube.com/watch?v={vid}", headers={"Accept-Language": "en-US"})
        length = re.search(r'"lengthSeconds":"(\d+)"', page)
        duration = int(length[1]) if length else None
        if not title:
            found = re.search(r"<title>(.*?)(?: - YouTube)?</title>", page)
            title = html.unescape(found[1]) if found else None
    except OSError:
        pass
    return {"id": vid, "title": song_title(title or "YouTube video"), "duration": duration}


