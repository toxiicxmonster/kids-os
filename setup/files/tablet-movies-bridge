def ytdlp(url):
    """A channel's video list (ids, titles, lengths) in one request: no downloads,
    no per-video lookups."""
    env = {**os.environ, "HOME": str(STATE), "XDG_CACHE_HOME": str(STATE / "cache")}
    out = subprocess.run([YTDLP, "-J", "--no-warnings", "--skip-download", "--flat-playlist", url],
                         capture_output=True, text=True, timeout=180, env=env)
    if out.returncode:
        raise RuntimeError("YouTube didn't answer: " + (out.stderr.strip().splitlines() or ["?"])[-1])
    return json.loads(out.stdout)


def song_title(title):
    """'"Airplane Mode!" Flying Dance ✈️ | Danny Go! Songs for Kids' -> 'Airplane Mode!'"""
    head = title.split(" | ")[0].strip()
    quoted = re.match(r'^["“](.+?)["”]', head)
    return (quoted[1] if quoted else head)[:48]


def dance_channel():
    """The Danny Go! channel's videos (cached for 6 hours)."""
    if time.time() - channel_cache["at"] > 6 * 3600 or not channel_cache["songs"]:
        entries = ytdlp(DANCE_CHANNEL).get("entries") or []
        channel_cache["songs"] = [{"id": e["id"], "title": song_title(e.get("title") or ""),
                                   "full_title": e.get("title"), "duration": int(e["duration"])}
                                  for e in entries if e.get("id") and e.get("duration")]
        channel_cache["at"] = time.time()
    return channel_cache["songs"]


def youtube_id(ref):
    ref = str(ref).strip()
    found = re.search(r"(?:v=|youtu\.be/|shorts/|embed/|live/)([A-Za-z0-9_-]{11})", ref)
    if found:
        return found[1]
    if VIDEO_ID.fullmatch(ref):
        return ref
    raise ValueError("paste a YouTube link (youtube.com/watch?v=... or youtu.be/...)")


def add_song(cfg, ref):
    vid = youtube_id(ref)
    songs = cfg.setdefault("dance", [])
    if not any(song["id"] == vid for song in songs):
        song = next((song for song in dance_channel() if song["id"] == vid), None) or video_info(vid)
        songs.append({k: song[k] for k in ("id", "title", "duration")})
        save(cfg)
    return vid


def video_info(vid):
    """Any YouTube video: its title from YouTube's oEmbed (link preview) service,
    its length from its public page when that has it (else None: dance_watch
    then notices the end by YouTube moving on to another video)."""
    title = None
    try:
        q = urllib.parse.urlencode({"url": f"https://www.youtube.com/watch?v={vid}", "format": "json"})
        title = json.loads(fetch(f"https://www.youtube.com/oembed?{q}")).get("title")
    except urllib.error.HTTPError as e:
        if e.code in (400, 404):
            raise ValueError("YouTube doesn't have that video")
    duration = None
    try:
        page = fetch(f"https://www.youtube.com/watch?v={vid}", headers={"Accept-Language": "en-US"})
        length = re.search(r'"lengthSeconds":"(\d+)"', page)
        duration = int(length[1]) if length else None
        if not title:
            found = re.search(r"<title>(.*?)(?: - YouTube)?</title>", page)
            title = html.unescape(found[1]) if found else None
    except OSError:
        pass
    return {"id": vid, "title": song_title(title or "YouTube video"), "duration": duration}


def remove_song(cfg, vid):
