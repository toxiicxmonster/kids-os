    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    if not tablet_mode(cfg):
        return {"result": "use_tv", "message": "The TV is on duty: play it there."}
    if song is not None:
        found = next((s for s in cfg.get("dance", []) if s["id"] == song), None)
        if not found:
            return {"result": "error", "message": "That song isn't on the list."}
        title, kind, out = found["title"], "dance", {"video": song}
    else:
        item = next((m for m in cfg.get("movies", []) if m["key"] == key), None)
        if not item:
            return {"result": "error", "message": "That isn't on the list."}
        if item.get("kind") not in PLEX_TYPES:
