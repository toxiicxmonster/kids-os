def other_youtube(tv, ids):
    """The first song in YouTube (over Cast: all of them, queued). True once it's started."""
    kind, ip = tv["kind"], tv["ip"]
    if kind in CAST_TVS:
        return bool(cast_json("youtube", ip, *ids, timeout=70).get("playing"))
    link = f"https://www.youtube.com/watch?v={ids[0]}"
    if kind == "samsung":
        samsung_deep_link(tv, (SAMSUNG_YOUTUBE_APP,), f"v={ids[0]}")
