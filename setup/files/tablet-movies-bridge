def openclipart(path, timeout=30):
    # Openclipart turns away unknown user agents.
    return fetch(OPENCLIPART + path, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) KidsOS"},
                 timeout=timeout, raw=True)


def coloring_id(pid):
    """An Openclipart picture number, "c-" + a Crayola page's name, or "u" + 12
    hex digits for a page the parents added from a link or a file."""
    if not re.fullmatch(r"\d{1,9}|u[0-9a-f]{12}|c-[a-z0-9][a-z0-9.-]{1,150}", pid or ""):
        raise ValueError("not a coloring page")
    return pid


# ---- Crayola's free coloring pages (personal use: downloaded to this box only) ----------

CRAYOLA = "https://www.crayola.com"
CRAYOLA_INDEX = STATE / "crayola-index.json"  # the page names from Crayola's sitemap
CRAYOLA_SKIP = ("adult", "mandala", "foldable", "-card-", "gift-card", "tracing", "worksheet",
                "color-by-number", "word-search", "maze", "certificate", "bookmark")
crayola_lock = threading.Lock()


def crayola(path, timeout=30):
    return fetch(CRAYOLA + path, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) KidsOS"},
                 timeout=timeout, raw=True)


def crayola_index():
    """Every free coloring page's name (e.g. "cute-cat"), from Crayola's sitemap,
    kept for a week."""
    with crayola_lock:
        try:
            cached = json.loads(CRAYOLA_INDEX.read_text())
            if time.time() - cached["at"] < 7 * 86400 and cached["pages"]:
                return cached["pages"]
        except (FileNotFoundError, ValueError, KeyError):
            cached = None
        try:
            sitemap = crayola("/sitemap/sitemap.xml", timeout=60).decode(errors="replace")
        except OSError:
            if cached:
                return cached["pages"]  # a stale list beats none
            raise
        pages = sorted(set(re.findall(
            r"/free-coloring-pages/print/([a-z0-9][a-z0-9.-]+?)-coloring-page</loc>", sitemap)))
        STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
        CRAYOLA_INDEX.write_text(json.dumps({"at": time.time(), "pages": pages}))
        return pages


def crayola_title(name):
    return name.replace(".", "").replace("-", " ").strip().capitalize()[:60]


def crayola_image(name):
    """The picture on a Crayola page (its print page shows exactly one coloring page image)."""
    page = crayola(f"/free-coloring-pages/print/{name}-coloring-page").decode(errors="replace")
    for src in re.findall(r'src="(/images/default-source/coloring-page-images/[^"?]+\.(?:png|jpe?g))', page):
        if not re.search(r"/(navigation-icons|buttons)/|banner|logo", src):
            return crayola(src, timeout=60)
    raise KeyError(f"no picture on Crayola's {name} page")


def crayola_search(q):
    """Crayola pages whose names have all the words searched for; simple
    (short) names first, and none of the grown-up or printable-craft ones."""
    words = re.findall(r"[a-z0-9]+", (q or "").lower())
    if not words:
        return []
    def has(name, w):  # a whole word of the name, or its plural ("car" isn't "carter")
        return any(part in (w, w + "s", w + "es") or w in (part + "s", part + "es") for part in name.split("-"))
    found = [n for n in crayola_index()
             if all(has(n, w) for w in words) and not any(k in f"-{n}-" for k in CRAYOLA_SKIP)]
    found.sort(key=lambda n: (len(n), n))
    return [{"id": f"c-{n}", "title": crayola_title(n)} for n in found[:48]]


COLORING_MAX_BYTES = 20_000_000


def coloring_image(data):
    """Raster image bytes from what the parents gave: PNG/JPEG/GIF/WebP as is,
    SVG drawn by rsvg-convert."""
    head = data[:2048].lstrip().lower()
    if head.startswith(b"<?xml") or b"<svg" in head:
        out = subprocess.run(["rsvg-convert", "-w", "2000", "--keep-aspect-ratio"], input=data,
                             capture_output=True, timeout=60)
        if out.returncode or not out.stdout:
            raise ValueError("couldn't read that SVG drawing")
        return out.stdout
    return data


def coloring_add_own(data, title):
    """Make a page from an image the parents supplied (a link or a file),
    keep it, and put it on the list."""
    if not data:
        raise ValueError("that file is empty")
    if len(data) > COLORING_MAX_BYTES:
        raise ValueError("pictures up to 20 MB, please")
    try:
        page = coloring_prepare(coloring_image(data))
    except (OSError, SyntaxError) as e:  # PIL: not an image it knows
        raise ValueError("that isn't a picture (PNG, JPG, GIF, WebP or SVG)") from e
    pid = "u" + hashlib.sha256(page).hexdigest()[:12]
    COLORING.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = COLORING / f"{pid}.png"
    tmp = path.with_suffix(f".{threading.get_ident()}.tmp")
    tmp.write_bytes(page)
    tmp.replace(path)
    title = (title or "").strip()[:60] or "My page"
    with lock:
        cfg = load()
        pages = cfg.setdefault("coloring", [])
        if not any(p["id"] == pid for p in pages):
            pages.append({"id": pid, "title": title})
            save(cfg)
        return {"id": pid, "count": len(pages)}


def coloring_from_url(url, title):
    """A page from a link: an Openclipart page (by its number) or any picture's address."""
    url = (url or "").strip()
    c = re.search(r"crayola\.com/(?:[a-z]{2}-[a-z]{2}/)?free-coloring-pages/print/"
                  r"([a-z0-9][a-z0-9.-]+?)-coloring-page", url)
    if c:
        pid = f"c-{c[1]}"
        coloring_file(pid)
        with lock:
            cfg = load()
            pages = cfg.setdefault("coloring", [])
            if not any(p["id"] == pid for p in pages):
                pages.append({"id": pid, "title": (title or "").strip()[:60] or crayola_title(c[1])})
                save(cfg)
            return {"id": pid, "count": len(pages)}
    m = re.search(r"openclipart\.org/(?:detail|image/\d+px|download)/(\d+)", url)
    if m:
        coloring_file(m[1])
        with lock:
            cfg = load()
            pages = cfg.setdefault("coloring", [])
            if not any(p["id"] == m[1] for p in pages):
                slug = re.search(r"/detail/\d+/([a-z0-9-]+)", url)
                pages.append({"id": m[1], "title": (title or "").strip()[:60]
                              or (slug[1].replace("-", " ").capitalize()[:60] if slug else "Coloring page")})
                save(cfg)
            return {"id": m[1], "count": len(pages)}
    if not re.match(r"https?://", url, re.I):
        raise ValueError("paste a link that starts with http:// or https://")
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) KidsOS"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = r.read(COLORING_MAX_BYTES + 1)
    if not title:
        title = urllib.parse.unquote(urllib.parse.urlparse(url).path.rsplit("/", 1)[-1]).rsplit(".", 1)[0]
        title = re.sub(r"[-_]+", " ", title).strip().capitalize()
    return coloring_add_own(data, title)


def coloring_prepare(data):
    """A picture as a coloring page: black lines on white (nothing
    grey, so a fill stops at the lines), lines thickened a little so fills don't
    leak through gaps, cropped and scaled to about the size of the screen."""
    from PIL import Image, ImageFilter, ImageOps
    art = Image.open(io.BytesIO(data)).convert("RGBA")
    paper = Image.new("RGBA", art.size, "white")
    paper.alpha_composite(art)
    page = paper.convert("L")
    box = ImageOps.invert(page).point(lambda v: 255 if v > 60 else 0).getbbox()
    if not box:
        raise ValueError("that picture is blank")
    page = page.crop(box)
    scale = min(1500 / page.width, 1050 / page.height)
    page = page.resize((max(1, round(page.width * scale)), max(1, round(page.height * scale))), Image.LANCZOS)
    page = page.point(lambda v: 0 if v < 170 else 255).filter(ImageFilter.MinFilter(3))
    framed = Image.new("L", (page.width + 80, page.height + 80), 255)
    framed.paste(page, (40, 40))
    out = io.BytesIO()
    framed.convert("1").save(out, "PNG", optimize=True)
    return out.getvalue()


def coloring_file(pid):
    """The page's local PNG, downloading it (Crayola or Openclipart) the first time."""
    path = COLORING / f"{coloring_id(pid)}.png"
    if not path.exists():
        if pid.startswith("u"):
            raise KeyError(pid)  # the parents' own page, and its file is gone
        COLORING.mkdir(mode=0o700, parents=True, exist_ok=True)
        art = crayola_image(pid[2:]) if pid.startswith("c-") else openclipart(f"/image/2000px/{pid}")
        data = coloring_prepare(art)
        tmp = path.with_suffix(f".{threading.get_ident()}.tmp")
        tmp.write_bytes(data)
        tmp.replace(path)
    return path


def coloring_search(q):
    """Pages for the parents to choose from: Crayola's free coloring pages."""
    return crayola_search((q or "").strip()[:60])


def coloring_thumb(pid):
    """A small picture of a page for the parents' search results (kept, so a
    second look is quick); pages already on the list use their own file."""
    path = COLORING / f"{coloring_id(pid)}.png"
    if path.exists():
        return path.read_bytes(), "image/png"
    if pid.startswith("u"):
        raise KeyError(pid)
    thumbs = STATE / "coloring-thumbs"
    thumb = thumbs / f"{pid}.jpg"
    if not thumb.exists():
        from PIL import Image
        art = Image.open(io.BytesIO(crayola_image(pid[2:]) if pid.startswith("c-")
                                    else openclipart(f"/image/400px/{pid}"))).convert("RGBA")
        paper = Image.new("RGBA", art.size, "white")
        paper.alpha_composite(art)
        paper = paper.convert("RGB")
        paper.thumbnail((300, 300))
        thumbs.mkdir(mode=0o700, parents=True, exist_ok=True)
        out = io.BytesIO()
        paper.save(out, "JPEG", quality=80)
        tmp = thumb.with_suffix(f".{threading.get_ident()}.tmp")
        tmp.write_bytes(out.getvalue())
        tmp.replace(thumb)
    return thumb.read_bytes(), "image/jpeg"


def coloring_starter():
    """The first time: the starter pages, downloaded in the background."""
    with lock:
        cfg = load()
        if "coloring" not in cfg:
            cfg["coloring"] = [{"id": pid, "title": title} for pid, title in COLORING_STARTER]
            cfg["coloring_starter"] = 2
            save(cfg)
        elif cfg.get("coloring_starter", 1) < 2:
            # The first starter set (Openclipart) gives way to the Crayola one;
            # pages the parents added themselves stay, after the new ones.
            old = set(COLORING_STARTER_V1)
            own = [p for p in cfg["coloring"] if p["id"] not in old]
            cfg["coloring"] = [{"id": pid, "title": title} for pid, title in COLORING_STARTER] + own
            cfg["coloring_starter"] = 2
            save(cfg)
            for pid in old:
                (COLORING / f"{pid}.png").unlink(missing_ok=True)
        pages = [p["id"] for p in cfg["coloring"]]
    for pid in pages:
        try:
            coloring_file(pid)
        except Exception as e:  # tried again when the app asks for it
            print(f"coloring page {pid}: {e!r}", flush=True)


# ---- themes -------------------------------------------------------------------------

def active_kid():
    """The user of the active graphical session on the screen, if it isn't the parent."""
    out = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[2] != PARENT_USER:
            # (loginctl prints properties in its own order, so read them by name)
            props = dict(line.split("=", 1) for line in subprocess.run(
                ["loginctl", "show-session", fields[0], "-p", "Type", "-p", "Active", "-p", "Seat"],
                capture_output=True, text=True).stdout.splitlines() if "=" in line)
            if props.get("Type") in ("wayland", "x11") and props.get("Active") == "yes"                     and props.get("Seat") == "seat0":
                return fields[2]
    return None


def theme_of(cfg, user):
    return cfg.get("themes", {}).get(user or "", DEFAULT_THEME)


def set_theme(cfg, user, theme):
    if theme not in THEMES:
        raise ValueError(f"themes: {', '.join(THEMES)}")
    if not user or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user):
        raise ValueError("no such user")
    cfg.setdefault("themes", {})[user] = theme
    save(cfg)


# ---- who may change settings ----------------------------------------------------------

def parent_on_desktop():
    out = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[2] == PARENT_USER:
            props = dict(kv.split("=", 1) for kv in subprocess.run(
                ["loginctl", "show-session", fields[0], "-p", "Type", "-p", "Active"],
                capture_output=True, text=True).stdout.splitlines() if "=" in kv)
            if props.get("Type") in ("wayland", "x11") and props.get("Active") == "yes":
                return True
    return False


# ---- HTTP server -------------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        print(f"{self.client_address[0]} {fmt % args}", flush=True)

    def reply(self, code, body, ctype="application/json", headers=None):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for name, value in (headers or {}).items():
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(data)

    def body_json(self):
        length = int(self.headers.get("Content-Length") or 0)
        if not 0 < length <= 4096:
            return {}
        try:
            return json.loads(self.rfile.read(length))
        except ValueError:
            return {}

    def handle_any(self, method):
        client = ipaddress.ip_address(self.client_address[0])
        path = urllib.parse.urlparse(self.path)
        if path.path in ("/", "/portal") or path.path.startswith("/api/portal/"):
            if not any(client in net for net in HOME_NETWORKS + ALLOWED_CLIENTS):
                return self.reply(403, {"error": "forbidden"})
            try:
                return self.handle_portal(method, path, client)
            except KeyError:
                return self.reply(404, {"error": "not_found"})
            except ValueError as e:
                return self.reply(400, {"error": str(e)})
            except Exception as e:  # report, don't crash the server
                print(f"error on {method} {self.path}: {e!r}", flush=True)
                return self.reply(500, {"error": str(e)})
        if not any(client in net for net in ALLOWED_CLIENTS):
            return self.reply(403, {"error": "forbidden"})
        parts = [p for p in path.path.split("/") if p][1:]  # drop "api"
        query = urllib.parse.parse_qs(path.query)
        route = (method, parts[0] if parts else "")
        try:
            kid_routes = {("GET", "movies"), ("GET", "poster"), ("POST", "play"), ("GET", "theme"),
                          ("POST", "theme"), ("GET", "dance"), ("GET", "dance-thumb"), ("POST", "dance-play"),
                          ("GET", "allowed"), ("POST", "activity"), ("GET", "coloring"),
                          ("GET", "coloring-page"), ("POST", "play-local"), ("POST", "dance-local")}
            if route not in kid_routes and not (client.is_loopback or parent_on_desktop()):
                return self.reply(403, {"error": "parent_only"})
            # Whose lists: the kid on the screen; for the parent (Movies & TV setup
            # in parent mode), ?kid= or the kid whose tablet they opened.
            if route in kid_routes:
                kid = active_kid()
            else:
                with lock:
                    kid = (query.get("kid") or [None])[0] or load().get("parent_kid")
            view = lambda cfg: for_kid(cfg, kid)
            if route in (("POST", "play"), ("POST", "dance-play")):
                # Slow (TV and server round trips): don't hold the config lock.
                if not play_lock.acquire(blocking=False):
                    return self.reply(200, {"result": "busy", "message": "Already starting a movie."})
                try:
                    with lock:
                        cfg = view(load())
                    arg = parts[1] if len(parts) > 1 else ""
                    if route[1] == "dance-play":
                        return self.reply(200, play(cfg, None, dance=[v for v in arg.split(",") if v]))
                    return self.reply(200, play(cfg, arg or None))
                finally:
                    play_lock.release()
            if route in (("POST", "play-local"), ("POST", "dance-local")):
                # Plex round trips (episode, progress), so outside the config lock.
                with lock:
                    cfg = view(load())
                arg = parts[1] if len(parts) > 1 else ""
                if route[1] == "dance-local":
                    return self.reply(200, play_local(cfg, song=arg))
                return self.reply(200, play_local(cfg, key=arg))
            if route == ("GET", "dance-thumb"):
                return self.reply(200, dance_thumb(parts[1] if len(parts) > 1 else ""), "image/jpeg")
            if route == ("GET", "poster"):
                with lock:
                    cfg = view(load())
                return self.reply(200, poster(cfg, parts[1] if len(parts) > 1 else ""), "image/jpeg")
            if route == ("GET", "coloring-page"):
                # (no config lock: the first time, it's downloaded)
                return self.reply(200, coloring_file(parts[1] if len(parts) > 1 else "").read_bytes(), "image/png")
            if route == ("GET", "allowed"):
                with lock:
                    cfg = view(load())
                allowed, message, left = kid_allowed(cfg.root, cfg.kid)
                return self.reply(200, {"allowed": allowed, "message": message, "minutes_left": left,
                                        "kid": cfg.kid})
            if route == ("POST", "activity"):
                title = (query.get("title") or [""])[0][:80]
                if title and active_kid():
                    add_history(active_kid(), "app", title)
                return self.reply(200, {"ok": True})
            if route == ("POST", "parent-kid"):
                with lock:
                    cfg = load()
                    if (parts[1] if len(parts) > 1 else "") not in kid_users():
                        raise ValueError("no such kid")
                    cfg["parent_kid"] = parts[1]
                    save(cfg)
                return self.reply(200, {"parent_kid": parts[1]})
            with lock:
                return self.reply(*self.dispatch(view(load()), route, parts, query))
        except KeyError:
            return self.reply(404, {"error": "not_found"})
        except ValueError as e:
            return self.reply(400, {"error": str(e)})
        except Exception as e:  # report, don't crash the server
            print(f"error on {method} {self.path}: {e!r}", flush=True)
            return self.reply(500, {"error": str(e)})

    def dispatch(self, cfg, route, parts, query):
        arg = parts[1] if len(parts) > 1 else None
        if route == ("GET", "movies"):
            tv = cfg.get("tv") or {}
            until = paused_until(cfg)
            movies = favorites_first(cfg["movies"], cfg.kid if isinstance(cfg, KidView) else None)
            return 200, {"movies": [{k: m.get(k) for k in ("key", "title", "year", "kind")} for m in movies],
                         "tv": tv.get("location") or tv.get("name"),
                         "paused": until is not None, "pause_text": pause_text(until),
                         "local": tablet_mode(cfg),
                         "cooldown": cooldown_left(), "theme": theme_of(cfg, active_kid())}
        if route == ("GET", "theme"):
            return 200, {"theme": theme_of(cfg, active_kid()), "themes": THEMES}
        if route == ("GET", "coloring"):
            return 200, {"pages": cfg.get("coloring", []), "theme": theme_of(cfg, active_kid())}
        if route == ("GET", "dance"):
            until = paused_until(cfg)
            return 200, {"songs": [{k: song[k] for k in ("id", "title")} for song in cfg.get("dance", [])],
                         "paused": until is not None, "local": tablet_mode(cfg), "cooldown": cooldown_left(),
                         "theme": theme_of(cfg, active_kid()), "party_max": DANCE_PARTY_MAX}
        if route == ("POST", "theme"):
            kid = active_kid()
            set_theme(cfg, kid, arg)
            return 200, {"theme": arg, "user": kid}
        if route == ("GET", "themes"):
            return 200, {"themes": cfg.get("themes", {}), "choices": THEMES, "default": DEFAULT_THEME}
        if route == ("POST", "themes"):
            set_theme(cfg, arg, parts[2] if len(parts) > 2 else None)
            return 200, {"themes": cfg["themes"]}
        if route == ("GET", "setup"):
            return 200, {"linked": "account_token" in cfg, "account": cfg.get("account"),
                         "profile": cfg.get("profile"), "server": cfg.get("server_name"),
                         "tv": cfg.get("tv"), "movies": len(cfg["movies"]),
                         "portal_url": f"http://{socket.gethostname()}.local:{LISTEN[1]}/",
                         "portal_pin_set": "portal_pin" in cfg}
        if route == ("POST", "portal-pin"):
            set_portal_pin(cfg, self.body_json().get("pin", ""))
            return 200, {"portal_pin_set": True}
        if route == ("POST", "link"):
            return 200, link_start(cfg)
        if route == ("GET", "link"):
            return 200, link_poll(cfg)
        if route == ("GET", "profiles"):
            return 200, {"profiles": profiles(cfg)}
        if route == ("POST", "profile"):
            use_profile(cfg, arg)
            return 200, {"profile": cfg["profile"], "server": cfg["server_name"]}
        if route == ("GET", "tvs"):
            return 200, {"tvs": discover_tvs()}
        if route == ("POST", "tv"):
            tv = next(t for t in discover_tvs() if t["serial"] == arg)
            cfg["tv"] = {k: tv[k] for k in ("serial", "ip", "name", "location")}
            save(cfg)
            return 200, {"tv": cfg["tv"]}
        if route == ("GET", "library"):
            return 200, {"movies": library(cfg, (query.get("q") or [""])[0])}
        if route == ("POST", "movies"):
            add_item(cfg, arg)
            return 200, {"movies": len(cfg["movies"])}
        if route == ("DELETE", "movies"):
            remove_item(cfg, arg)
            return 200, {"movies": len(cfg["movies"])}
        if route == ("POST", "netflix"):
            return 200, {"key": add_netflix(cfg, urllib.parse.unquote(arg or "")), "movies": len(cfg["movies"])}
        raise KeyError(route)

    def handle_portal(self, method, path, client):
        """The parents' phone/computer portal: pause movie time, edit the list."""
        if path.path in ("/", "/portal"):
            return self.reply(200, PORTAL_PAGE.read_bytes(), "text/html; charset=utf-8")
        parts = [p for p in path.path.split("/") if p][2:]  # drop "api", "portal"
        route = (method, parts[0] if parts else "")
        arg = parts[1] if len(parts) > 1 else None
        cookies = dict(c.strip().split("=", 1) for c in (self.headers.get("Cookie") or "").split(";") if "=" in c)

        if route == ("POST", "login"):
            with lock:
                token, error = portal_login(load(), str(client), self.body_json().get("pin", ""))
            if error:
                return self.reply(401, {"error": error})
            cookie = (f"{PORTAL_COOKIE}={token}; Path=/; HttpOnly; SameSite=Strict; "
                      f"Max-Age={PORTAL_SESSION_DAYS * 86400}")
            return self.reply(200, {"ok": True}, headers={"Set-Cookie": cookie})

        query = urllib.parse.parse_qs(path.query)
        kid = (query.get("kid") or [None])[0]
        view = lambda cfg: for_kid(cfg, kid)
        with lock:
            cfg = load()
            authed = portal_session_ok(cfg, cookies.get(PORTAL_COOKIE))
        if authed and route == ("GET", "dance-library"):
            q = (query.get("q") or [""])[0].lower()
            with lock:
                chosen = {song["id"] for song in view(load()).get("dance", [])}
            found = [{**song, "chosen": song["id"] in chosen} for song in dance_channel()
                     if q in song["full_title"].lower()]
            return self.reply(200, {"songs": found[:150]})
        if authed and route in (("POST", "dance"), ("POST", "dance-link")):
            ref = self.body_json().get("ref", "") if route[1] == "dance-link" else arg
            dance_channel()  # (slow the first time: before taking the config lock)
            with lock:
                cfg = view(load())
                add_song(cfg, ref)
                return self.reply(200, {"count": len(cfg["dance"])})
        if authed and route == ("GET", "system"):
            return self.reply(200, system_status())
        if authed and route == ("GET", "now"):
            return self.reply(200, tv_now())
        if authed and route == ("POST", "tv-stop"):
            return self.reply(200, tv_stop())
        if authed and route == ("GET", "history"):
            with side_lock:
                events = read_side(HISTORY)
            if kid:
                events = [e for e in events if e["kid"] == kid]
            return self.reply(200, {"events": events[-150:][::-1], "names": {k: kid_name(k) for k in kid_users()}})
        if authed and route == ("GET", "week"):
            kids = kid_users()
            return self.reply(200, week_summary(kid if kid in kids else kids[0]))
        if authed and route == ("GET", "coloring"):
            with lock:
                return self.reply(200, {"pages": load().get("coloring", [])})
        if authed and route == ("GET", "coloring-search"):
            with lock:
                chosen = {p["id"] for p in load().get("coloring", [])}
            found = coloring_search((query.get("q") or [""])[0])
            return self.reply(200, {"pages": [{**p, "chosen": p["id"] in chosen} for p in found]})
        if authed and route == ("GET", "coloring-thumb"):
            return self.reply(200, *coloring_thumb(arg or ""))
        if authed and route == ("GET", "coloring-page"):
            return self.reply(200, coloring_file(arg or "").read_bytes(), "image/png")
        if authed and route == ("POST", "coloring-url"):
            body = self.body_json()
            try:
                return self.reply(200, coloring_from_url(body.get("url"), body.get("title")))
            except urllib.error.URLError as e:
                raise ValueError(f"couldn't get that link ({getattr(e, 'reason', e)})") from e
        if authed and route == ("POST", "coloring-upload"):
            # The picture file itself is the request body (not JSON).
            length = int(self.headers.get("Content-Length") or 0)
            if not 0 < length <= COLORING_MAX_BYTES:
                raise ValueError("pictures up to 20 MB, please")
            data = self.rfile.read(length)
            title = (query.get("title") or [""])[0]
            return self.reply(200, coloring_add_own(data, title))
        if authed and route == ("POST", "coloring"):
            coloring_file(arg or "")  # download it first (slow), outside the config lock
            title = str(self.body_json().get("title") or "").strip()[:60] or "Coloring page"
            with lock:
                cfg = load()
                pages = cfg.setdefault("coloring", [])
                if not any(p["id"] == arg for p in pages):
                    pages.append({"id": arg, "title": title})
                    save(cfg)
                return self.reply(200, {"count": len(pages)})
        if authed and route == ("DELETE", "coloring"):
            coloring_id(arg)
            with lock:
                cfg = load()
                cfg["coloring"] = [p for p in cfg.get("coloring", []) if p["id"] != arg]
                save(cfg)
            (COLORING / f"{arg}.png").unlink(missing_ok=True)
            return self.reply(200, {"count": len(cfg["coloring"])})
        if authed and route == ("GET", "volume"):
            return self.reply(200, {"percent": kid_volume()})
        if authed and route == ("POST", "volume"):
            percent = self.body_json().get("percent")
            if not isinstance(percent, int) or not 0 <= percent <= 100:
                raise ValueError("volume must be 0 to 100")
            return self.reply(200, {"percent": kid_volume(percent)})
        with lock:
            cfg = view(load())
            if route == ("GET", "status") and not authed:
                return self.reply(200, {"authed": False, "pin_set": "portal_pin" in cfg})
            if not authed:
                return self.reply(401, {"error": "Please enter the PIN."})
            if route == ("GET", "status"):
                until = paused_until(cfg)
                tv = cfg.get("tv") or {}
                return self.reply(200, {
                    "authed": True, "paused": until is not None, "pause_text": pause_text(until),
                    "tv": tv.get("location") or tv.get("name"), "kid": cfg.kid,
                    "items": [{k: m.get(k) for k in ("key", "title", "year", "kind")} for m in cfg["movies"]]})
            if route == ("GET", "kids"):
                return self.reply(200, {"kids": [{"user": k, "name": kid_name(k)} for k in kid_users()]})
            if route == ("GET", "schedule"):
                allowed, message, left = kid_allowed(cfg.root, cfg.kid)
                own = kid_settings(cfg.root, cfg.kid)
                return self.reply(200, {"schedule": schedule_of(cfg.root, cfg.kid), "allowed": allowed,
                                        "message": message, "minutes_left": left,
                                        "used_today": minutes_used(cfg.kid),
                                        "extra_until": own.get("extra_until", 0),
                                        "sleep_until": own.get("sleep_until", 0)})
            if route == ("POST", "schedule"):
                set_schedule(cfg.root, cfg.kid, self.body_json())
                return self.reply(200, {"schedule": schedule_of(cfg.root, cfg.kid)})
            if route == ("POST", "extra"):
                own = kid_settings(cfg.root, cfg.kid)
                minutes = int(self.body_json().get("minutes", 30))
                if not 1 <= minutes <= 12 * 60:
                    raise ValueError("1 minute to 12 hours")
                own["extra_until"] = max(time.time(), own.get("extra_until", 0)) + minutes * 60
                own.pop("sleep_until", None)
                save(cfg)
                return self.reply(200, {"extra_until": own["extra_until"]})
            if route == ("POST", "sleep"):
                own = kid_settings(cfg.root, cfg.kid)
                own["sleep_until"] = next_start(cfg.root, cfg.kid)
                own.pop("extra_until", None)
                save(cfg)
                return self.reply(200, {"sleep_until": own["sleep_until"]})
            if route == ("POST", "pause"):
                set_pause(cfg.root, self.body_json().get("minutes"))
                return self.reply(200, {"pause_text": pause_text(paused_until(cfg))})
            if route == ("GET", "library"):
                q = (urllib.parse.parse_qs(path.query).get("q") or [""])[0]
                chosen = {m["key"] for m in cfg["movies"]}
                return self.reply(200, {"items": [{**m, "chosen": m["key"] in chosen, "thumb": None}
                                                  for m in library(cfg, q)]})
            if route == ("POST", "items"):
                add_item(cfg, arg)
                return self.reply(200, {"count": len(cfg["movies"])})
            if route == ("DELETE", "items"):
                remove_item(cfg, arg)
                return self.reply(200, {"count": len(cfg["movies"])})
            if route == ("POST", "netflix"):
                key = add_netflix(cfg, self.body_json().get("ref", ""))
                return self.reply(200, {"key": key, "count": len(cfg["movies"])})
            if route == ("GET", "dance"):
                return self.reply(200, {"songs": cfg.get("dance", [])})
            if route == ("DELETE", "dance"):
                remove_song(cfg, arg)
                return self.reply(200, {"count": len(cfg["dance"])})
            if route == ("POST", "logout"):
                cfg.get("portal_sessions", {}).pop(
                    hashlib.sha256(cookies.get(PORTAL_COOKIE, "").encode()).hexdigest(), None)
                save(cfg)
                return self.reply(200, {"ok": True}, headers={"Set-Cookie": f"{PORTAL_COOKIE}=; Path=/; Max-Age=0"})
        if route == ("GET", "poster"):
            return self.reply(200, poster(cfg, arg or ""), "image/jpeg")
        if route == ("GET", "dance-thumb"):
            return self.reply(200, dance_thumb(arg or ""), "image/jpeg")
        raise KeyError(route)

    def do_GET(self):
        self.handle_any("GET")

    def do_POST(self):
        self.handle_any("POST")

    def do_DELETE(self):
        self.handle_any("DELETE")


def check():
    """Every step of a play except the final command to the TV (nothing changes on screen)."""
    cfg = load()
    steps = [
        ("Plex account linked", lambda: cfg.get("account") or None),
        ("profile and server", lambda: f"{cfg['profile']} on {cfg['server_name']} via {cfg['server_url']}"),
        ("server answers as the profile", lambda: str(len(plex_json(
            cfg, f"{cfg['server_url']}/library/sections", cfg["server_token"])["MediaContainer"]
            .get("Directory", []))) + " libraries"),
        ("approved movies and shows", lambda: len(cfg["movies"]) or None),
        ("TV", lambda: (lambda tv: tv and f"{tv['location']} / {tv['name']} at {tv['ip']}: {tv['power']}")(
            find_tv(cfg))),
        ("Plex open on the TV", lambda: companion_id(cfg["tv"]["ip"])),
        ("reset to start", lambda: (lambda plex: str(reset_progress(
            cfg, plex[0]["key"] if plex[0].get("kind") != "show" else pick_episode(cfg, plex[0]["key"]))))(
            [m for m in cfg["movies"] if m.get("kind") != "netflix"])),
        ("TV shows pick a random episode", lambda: ", ".join(
            f"{m['title']} -> episode {pick_episode(cfg, m['key'])}" for m in cfg["movies"]
            if m.get("kind") == "show") or "no shows on the list"),
        ("Netflix on the TV", lambda: {True: "yes", False: None, None: "can't tell (app list blocked)"}[
            roku_info(cfg["tv"]["ip"]).get("netflix")]),
    ]
    ok = True
    for name, step in steps:
        try:
            result = step()
        except Exception as e:  # report every step
            result, ok = None, False
            print(f"FAIL  {name}: {e!r}")
            continue
        ok &= result is not None
        print(f"{'ok  ' if result is not None else 'FAIL'}  {name}: {result}")
    return 0 if ok else 1


def main():
    if "--set-pin" in sys.argv:
        # sudo -u tablet-movies tablet-movies-bridge --set-pin 1234
        cfg = load()
        set_portal_pin(cfg, sys.argv[sys.argv.index("--set-pin") + 1])
        raise SystemExit("portal PIN set")
    if "--check" in sys.argv:
        raise SystemExit(check())
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    threading.Thread(target=seed_dance, daemon=True).start()
    threading.Thread(target=count_usage, daemon=True).start()
    threading.Thread(target=coloring_starter, daemon=True).start()
    server = http.server.ThreadingHTTPServer(LISTEN, Handler)
    print(f"listening on {LISTEN[0]}:{LISTEN[1]}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
