def local_ipv4s():
    out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True)
    for line in out.stdout.splitlines():
        dev, addr = line.split()[1], line.split()[3].split("/")[0]
        if not dev.startswith(("waydroid", "lxcbr", "docker", "virbr")):
            yield addr


def roku_info(ip):
    info = fetch(f"http://{ip}:8060/query/device-info", timeout=3)
    tag = lambda k: (re.search(f"<{k}>(.*?)</{k}>", info) or [None, ""])[1]
    tv = {"ip": ip, "serial": tag("serial-number") or tag("device-id"), "name": tag("user-device-name"),
          "location": tag("user-device-location"), "power": tag("power-mode")}
    try:
        apps = fetch(f"http://{ip}:8060/query/apps", timeout=3)
        tv["plex"] = f'id="{PLEX_ROKU_APP}"' in apps
        tv["netflix"] = f'id="{NETFLIX_ROKU_APP}"' in apps
    except OSError:
        tv["plex"] = tv["netflix"] = None  # app list blocked ("Limited" mobile-app control)
    return tv


def discover_tvs(wait=3.0):
    """Roku TVs (ECP) and LG webOS TVs (their second-screen service) on the home network."""
    searches = [(b"M-SEARCH * HTTP/1.1\r\nHost: 239.255.255.250:1900\r\nMan: \"ssdp:discover\"\r\n"
                 b"ST: " + st + b"\r\nMX: 2\r\n\r\n") for st in (b"roku:ecp", LG_SSDP_ST.encode())]
    ips = set()
    lg = {}  # ip -> device description URL
    socks = []
    for addr in local_ipv4s():
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(addr))
        s.bind((addr, 0))
        s.settimeout(0.3)
        for msg in searches:
            s.sendto(msg, ("239.255.255.250", 1900))
        socks.append(s)
    end = time.time() + wait
    while time.time() < end:
        for s in socks:
            try:
                data, peer = s.recvfrom(2048)
            except socket.timeout:
                continue
            low = data.lower()
            if LG_SSDP_ST.encode().lower() in low or b"webos" in low:
                found = re.search(rb"(?im)^location:\s*(\S+)", data)
                lg[peer[0]] = found[1].decode() if found else None
            elif b"roku" in low:
                ips.add(peer[0])
    tvs = []
    for ip in sorted(ips):
        try:
            tvs.append(roku_info(ip))
        except OSError:
            pass
    for ip, location in sorted(lg.items()):
        tvs.append(lg_describe(ip, location))
    return tvs


def find_tv(cfg):
    """The chosen TV's current info, rediscovering it if its address changed."""
    tv = cfg.get("tv")
    if not tv:
        return None
    if tv.get("kind") == "lg":
        return lg_find(tv)
    try:
        info = roku_info(tv["ip"])
        if info["serial"] == tv["serial"]:
            return info
    except OSError:
        pass
    for info in discover_tvs():
        if info["serial"] == tv["serial"]:
            with lock:
                fresh = load()
                if fresh.get("tv", {}).get("serial") == info["serial"]:
                    fresh["tv"]["ip"] = info["ip"]
                    save(fresh)
            return info
    return None


def companion_id(ip, timeout=2, port=8324):
