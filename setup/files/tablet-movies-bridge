def local_ipv4s():
    out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True)
    for line in out.stdout.splitlines():
        dev, addr = line.split()[1], line.split()[3].split("/")[0]
        if not dev.startswith(("waydroid", "lxcbr", "docker", "virbr")):
            yield addr


def roku_info(ip):
    info = fetch(f"http://{ip}:8060/query/device-info", timeout=3)
    tag = lambda k: (re.search(f"<{k}>(.*?)</{k}>", info) or [None, ""])[1]
    tv = {"ip": ip, "serial": tag("serial-number") or tag("device-id"), "name": tag("user-device-name"),
          "location": tag("user-device-location"), "power": tag("power-mode")}
    try:
        apps = fetch(f"http://{ip}:8060/query/apps", timeout=3)
        tv["plex"] = f'id="{PLEX_ROKU_APP}"' in apps
        tv["netflix"] = f'id="{NETFLIX_ROKU_APP}"' in apps
    except OSError:
        tv["plex"] = tv["netflix"] = None  # app list blocked ("Limited" mobile-app control)
    return tv


def discover_tvs(wait=3.0):
    msg = (b"M-SEARCH * HTTP/1.1\r\nHost: 239.255.255.250:1900\r\nMan: \"ssdp:discover\"\r\n"
           b"ST: roku:ecp\r\nMX: 2\r\n\r\n")
    ips = set()
    socks = []
    for addr in local_ipv4s():
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(addr))
        s.bind((addr, 0))
        s.settimeout(0.3)
        s.sendto(msg, ("239.255.255.250", 1900))
        socks.append(s)
    end = time.time() + wait
    while time.time() < end:
        for s in socks:
            try:
                data, peer = s.recvfrom(2048)
                if b"roku" in data.lower():
                    ips.add(peer[0])
            except socket.timeout:
                pass
    tvs = []
    for ip in sorted(ips):
        try:
            tvs.append(roku_info(ip))
        except OSError:
            pass
    return tvs


def find_tv(cfg):
    """The chosen TV's current info, rediscovering it if its address changed."""
    tv = cfg.get("tv")
    if not tv:
        return None
    try:
        info = roku_info(tv["ip"])
        if info["serial"] == tv["serial"]:
            return info
    except OSError:
        pass
    for info in discover_tvs():
        if info["serial"] == tv["serial"]:
            with lock:
                fresh = load()
                if fresh.get("tv", {}).get("serial") == info["serial"]:
                    fresh["tv"]["ip"] = info["ip"]
                    save(fresh)
            return info
    return None


def companion_id(ip, timeout=2):
    root = ET.fromstring(fetch(f"http://{ip}:8324/resources", timeout=timeout))
    return root.find("Player").get("machineIdentifier")


def cooldown_left():
    return max(0, round(PLAY_COOLDOWN - (time.time() - last_started)))


def play(cfg, key, dance=None):
    """A movie/show (key) or Dance songs (a list of video ids) from the kid's
    own lists, under one lockout (and only in their tablet time)."""
    global last_started, generation
    if cooldown_left():
        return {"result": "busy", "message": "The TV is catching up.", "cooldown": cooldown_left()}
    kid = cfg.kid if isinstance(cfg, KidView) else None
    if kid and not kid_allowed(cfg.root, kid)[0]:
        return {"result": "sleeping", "message": "The tablet is sleeping."}
    generation += 1
    result = start_dance(cfg, dance) if dance else start(cfg, key)
    if result["result"] == "playing":
        last_started = time.time()
        result["cooldown"] = PLAY_COOLDOWN
        if dance:
            songs = {song["id"]: song["title"] for song in cfg.get("dance", [])}
            title, kind = ", ".join(songs.get(v, v) for v in dance), "dance"
        else:
            item = next((m for m in cfg.get("movies", []) if m["key"] == key), {})
            title, kind = item.get("title", key), item.get("kind") or "movie"
        last_play.update(title=title, kind=kind, kid=kid, at=int(time.time()))
        if kid:
            add_history(kid, kind, title)
    return result


