SAMSUNG_YOUTUBE_APP = "111299001912"
FIRETV_PLEX = "com.plexapp.android"
FIRETV_JELLYFIN = "org.jellyfin.androidtv"
ANDROID_TV_APPS = {"com.netflix.ninja": "Netflix", "com.amazon.firetv.youtube": "YouTube",
                   "com.google.android.youtube.tv": "YouTube", FIRETV_PLEX: "Plex", FIRETV_JELLYFIN: "Jellyfin"}
TV_LABELS = {"roku": "Roku", "lg": "LG", "samsung": "Samsung", "googletv": "Google TV", "cast": "Chromecast",
             "vizio": "Vizio", "firetv": "Fire TV", "appletv": "Apple TV"}
OTHER_TVS = ("samsung", "googletv", "cast", "vizio", "firetv", "appletv")
CAST_TVS = ("googletv", "cast", "vizio")
# Pairings after choosing the TV (web page: start, then the code the TV shows).
TV_PAIRINGS = {"lg": ("airplay",), "samsung": ("airplay",), "appletv": ("airplay", "companion"),
               "googletv": ("remote",), "vizio": ("vizio",)}
PAIRED_MESSAGES = {
    "airplay": "Paired! Plex and Jellyfin titles play on the TV over AirPlay.",
    "companion": "Paired! The box can open Netflix and YouTube on the Apple TV, and go Home.",
    "remote": "Paired! The box can open Netflix on the TV, see if it's on and go Home.",
    "vizio": "Paired! The box can see if the TV is on and go Home.",
}
REDISCOVER_EVERY = 60  # seconds: a TV that moved is looked for at most this often
last_rediscover = {}


class TVError(OSError):
    pass


def tv_kind(tv):
    return (tv or {}).get("kind") or "roku"


def helper_json(cmd, env=None, timeout=40):
    """One of the helpers' one-shot commands: its last line of output (JSON)."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                             env={**os.environ, **(env or {})})
    except subprocess.TimeoutExpired as e:
        raise TVError("the TV didn't answer") from e
    except OSError as e:  # the helper isn't installed
        raise TVError(str(e)) from e
    lines = out.stdout.strip().splitlines()
    try:
        data = json.loads(lines[-1]) if lines else None
    except ValueError:
        data = None
    if out.returncode or data is None or (isinstance(data, dict) and "error" in data):
        raise TVError(data["error"] if isinstance(data, dict) and "error" in data
                      else (out.stderr.strip().splitlines() or ["no answer"])[-1])
    return data


def port_open(ip, port, timeout=1.5):
    try:
        socket.create_connection((ip, port), timeout=timeout).close()
        return True
    except OSError:
        return False


# Samsung (Tizen): REST on :8001 for the TV's info and apps, the remote-control
# WebSocket (wss :8002 with a token the TV gives once Allow is pressed) for
# buttons and deep links.

def samsung_info(ip):
    return json.loads(fetch(f"http://{ip}:8001/api/v2/", timeout=3))


def samsung_describe(ip):
    tv = {"kind": "samsung", "ip": ip, "serial": ip, "name": "Samsung TV", "location": "", "power": "PowerOff"}
    try:
        info = samsung_info(ip)
    except (OSError, ValueError):
        return tv
    device = info.get("device") or {}
    tv.update(serial=str(device.get("id") or info.get("id") or ip).removeprefix("uuid:"),
              name=f"Samsung {device.get('modelName') or 'TV'}",
              location=html.unescape(device.get("name") or info.get("name") or ""),
              power="PowerOn" if device.get("PowerState", "on") == "on" else "PowerOff")
    return tv


def samsung_ws(tv, wait=10):
    """The TV's remote-control WebSocket: (socket, token). A new client is asked
    about on the TV (Allow); the token it then gives is kept."""
    name = base64.b64encode(b"Kids OS").decode()
    token = tv.get("token")
    urls = [f"wss://{tv['ip']}:8002/api/v2/channels/samsung.remote.control?name={name}"
            + (f"&token={token}" if token else ""),
            f"ws://{tv['ip']}:8001/api/v2/channels/samsung.remote.control?name={name}"]  # older TVs
    last = None
    for url in urls:
        try:
            ws = WebSocket(url, timeout=5)
        except OSError as e:
            last = e
            continue
        end = time.time() + wait
        try:
            while True:
                msg = json.loads(ws.recv(max(0.5, end - time.time())))
                event = msg.get("event")
                if event == "ms.channel.connect":
                    return ws, (msg.get("data") or {}).get("token") or token
                if event in ("ms.channel.unauthorized", "ms.channel.timeOut"):
                    raise TVError("the TV said no (choose it again and press Allow)")
                if time.time() > end:
                    raise TVError("the TV didn't answer (press Allow on the TV)")
        except (OSError, ValueError) as e:
            ws.close()
            raise e if isinstance(e, TVError) else TVError(f"the TV didn't let us in ({e!r})")
    raise TVError(f"no remote control on the TV ({last!r})")


def samsung_pair(ip):
    try:
        ws, token = samsung_ws({"ip": ip}, wait=30)
    except TVError as e:
        raise ValueError(f"Pairing with the TV didn't finish: {e}.")
    ws.close()
    return token


def samsung_send(tv, *messages):
    ws, _ = samsung_ws(tv)
    try:
        for message in messages:
            ws.send(json.dumps(message))
            time.sleep(0.4)
    finally:
        ws.close()


def samsung_key(tv, key):
    samsung_send(tv, {"method": "ms.remote.control", "params": {
        "Cmd": "Click", "DataOfCmd": key, "Option": "false", "TypeOfRemote": "SendRemoteKey"}})


def samsung_deep_link(tv, apps, meta):
    """Opens the first of the apps the TV has, at the title (its metaTag)."""
    ws, _ = samsung_ws(tv)
    try:
        for app in apps:
            ws.send(json.dumps({"method": "ms.channel.emit", "params": {
                "event": "ed.apps.launch", "to": "host",
                "data": {"appId": app, "action_type": "DEEP_LINK", "metaTag": meta}}}))
            end = time.time() + 6
            while True:
                try:
                    msg = json.loads(ws.recv(max(0.5, end - time.time())))
                except (socket.timeout, ValueError):
                    return app  # no answer (some TVs don't say): take it as opened
                if msg.get("event") == "ed.apps.launch":
                    if str(msg.get("data")) == "200":
                        return app
                    break  # not this app id: the next one
                if time.time() > end:
                    return app
        raise TVError("the app isn't on the TV")
    finally:
        ws.close()


def samsung_now(tv):
    for name, apps in (("Netflix", SAMSUNG_NETFLIX_APPS), ("YouTube", (SAMSUNG_YOUTUBE_APP,))):
        for app in apps:
            try:
                if json.loads(fetch(f"http://{tv['ip']}:8001/api/v2/applications/{app}", timeout=3)).get("visible"):
                    return name, None
            except (OSError, ValueError):
                pass
    return None, None


# Fire TV: ADB over the network (Settings -> My Fire TV -> Developer options ->
# ADB debugging; the first connection is allowed on the TV). Its own adb
# server, keys in the bridge's state directory.

def adb_run(*args, timeout=15):
    env = {**os.environ, "HOME": str(STATE), "ANDROID_ADB_SERVER_PORT": "5039"}
    try:
        return subprocess.run([ADB, *args], capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise TVError(f"adb: {e}") from e


def firetv_shell(ip, command, timeout=15):
    serial = f"{ip}:5555"
    adb_run("connect", serial, timeout=10)
    out = adb_run("-s", serial, "shell", command, timeout=timeout)
    err = (out.stderr or "").strip()
    if "unauthorized" in err:
        raise TVError("the TV hasn't allowed this box (choose it again and allow it on the TV)")
    if out.returncode:
        raise TVError((err + "\n" + (out.stdout or "")).strip()[-500:] or "the TV didn't answer")
    return out.stdout


def firetv_pair(ip, wait=60):
    """Connects (the TV asks to allow it: tick "Always allow") and waits until allowed."""
    serial = f"{ip}:5555"
    end = time.time() + wait
    while time.time() < end:
        try:
            adb_run("connect", serial, timeout=10)
            if adb_run("-s", serial, "get-state", timeout=5).stdout.strip() == "device":
                return True
        except TVError:
            pass
        time.sleep(2)
    raise ValueError("The TV didn't allow the connection. Turn on ADB debugging (Settings, My Fire TV, "
                     "Developer options), choose the TV again, and allow it on the TV.")


def firetv_launch(ip, package):
    for category in ("android.intent.category.LEANBACK_LAUNCHER", "android.intent.category.LAUNCHER"):
        try:  # (monkey fails, saying "no activities found", if the app has none in that category)
            if "no activities found" not in firetv_shell(ip, f"monkey -p {package} -c {category} 1").lower():
                return
        except TVError as e:
            if "no activities found" not in str(e).lower():
                raise
    raise TVError(f"{package} isn't on the TV")


def firetv_view(ip, url, component=None, extra=""):
    out = firetv_shell(ip, "am start -a android.intent.action.VIEW" + (f" -n {component}" if component else "")
                       + f" -d {shlex.quote(url)} {extra}")
    if "Error" in out:
        raise TVError(out.strip().splitlines()[-1])


def firetv_app(ip):
    found = re.search(r"u0 ([\w.]+)/", firetv_shell(ip, "dumpsys window | grep -m1 mCurrentFocus"))
    return found[1] if found else None


def firetv_state(ip):
    """"play", "pause" or "buffer" from Android's media sessions; None otherwise."""
    try:
        states = re.findall(r"state=PlaybackState \{state=(\d+)", firetv_shell(ip, "dumpsys media_session"))
    except TVError:
        return None
    for code, name in (("3", "play"), ("6", "buffer"), ("2", "pause")):
        if code in states:
            return name
    return None


# Cast, the Android TV remote, Vizio SmartCast and Apple TV go through the helpers.

def cast_json(*args, timeout=40):
    return helper_json([CAST, *args], timeout=timeout)


def remote_json(tv, *args):
    return helper_json([CAST, "remote", tv["ip"], *args], timeout=30)


def vizio_json(tv, *args):
    return helper_json([CAST, "vizio", tv["ip"], *args], env={"TABLET_VIZIO_TOKEN": tv["vizio"]}, timeout=20)


def atv_json(tv, *args):
    env = {"TABLET_AIRPLAY_MODE": "classic", "TABLET_AIRPLAY_CREDENTIALS": tv.get("airplay") or "",
           "TABLET_COMPANION_CREDENTIALS": tv.get("companion") or ""}
    return helper_json([AIRPLAY, "atv", tv["ip"], *args], env=env, timeout=40)


def cast_describe(c):
    ip = c["ip"]
    vizio = "vizio" in (c.get("manufacturer") or "").lower() or port_open(ip, 7345, 1) or port_open(ip, 9000, 1)
    kind = "vizio" if vizio else "googletv" if c.get("android_tv") else "cast"
    return {"kind": kind, "ip": ip, "serial": c.get("uuid") or ip, "location": c.get("name") or "",
            "name": f"{TV_LABELS[kind]} ({c.get('model') or 'Cast'})", "power": "PowerOn"}


def dial_describe(ip, location):
    """A Fire TV found by DIAL (other DIAL devices: None)."""
    try:
        xml = fetch(location, timeout=3)
    except OSError:
        return None
    tag = lambda k: html.unescape((re.search(f"<{k}>(.*?)</{k}>", xml, re.S) or [None, ""])[1].strip())
    if "amazon" not in tag("manufacturer").lower():
        return None
    return {"kind": "firetv", "ip": ip, "serial": tag("UDN").removeprefix("uuid:") or ip,
            "name": f"Fire TV ({tag('modelName') or 'Amazon'})", "location": tag("friendlyName"),
            "power": "PowerOn"}


def discover_other(found_ips, samsung, dial, cast_found, airplay_found):
    """The other kinds' TVs from discovery, leaving out addresses already found."""
    seen, tvs = set(found_ips), []
    for ip in sorted(samsung):
        if ip not in seen:
            seen.add(ip)
            tvs.append(samsung_describe(ip))
    for c in cast_found:
        if c.get("ip") and c["ip"] not in seen:
            seen.add(c["ip"])
            tvs.append(cast_describe(c))
    for a in airplay_found:
        if a.get("apple_tv") and a.get("ip") not in seen:
            seen.add(a["ip"])
            tvs.append({"kind": "appletv", "ip": a["ip"], "serial": a.get("identifier") or a["ip"],
                        "name": f"Apple TV ({a.get('model') or 'tvOS'})", "location": a.get("name") or "",
                        "power": "PowerOn"})
    for ip, location in sorted(dial.items()):
        if ip not in seen and location:
            tv = dial_describe(ip, location)
            if tv:
                seen.add(ip)
                tvs.append(tv)
    return tvs


def other_power(tv):
    """"PowerOn" / "PowerOff", "NotPaired" (a Fire TV that hasn't allowed the box), or None."""
    kind, ip = tv["kind"], tv["ip"]
    try:
        if kind == "samsung":
            device = samsung_info(ip).get("device") or {}
            return "PowerOn" if device.get("PowerState", "on") == "on" else "PowerOff"
        if kind == "firetv":
            return "PowerOn" if "Awake" in firetv_shell(ip, "dumpsys power | grep -m1 mWakefulness=") else "PowerOff"
        if kind == "googletv" and tv.get("remote"):
            return "PowerOn" if remote_json(tv, "state").get("on") else "PowerOff"
        if kind == "vizio" and tv.get("vizio"):
            return "PowerOn" if vizio_json(tv, "power").get("on") else "PowerOff"
        if kind == "appletv" and tv.get("companion"):
            return "PowerOn" if atv_json(tv, "power").get("on") else "PowerOff"
    except OSError as e:
        print(f"{TV_LABELS[kind]} TV at {ip}: {e}", flush=True)
        if kind == "firetv" and "allowed" in str(e):
            return "NotPaired"
        if kind in ("samsung", "firetv"):
            return None
    # Not paired for its remote (or that failed): answering at all counts as on.
    if kind in CAST_TVS:
        return "PowerOn" if port_open(ip, 8009) else None
    if kind == "appletv":
        return "PowerOn" if port_open(ip, 7000) else None
    return None


def other_find(tv):
    power = other_power(tv)
    if power is None and time.time() - last_rediscover.get(tv["serial"], 0) > REDISCOVER_EVERY:
        last_rediscover[tv["serial"]] = time.time()
        moved = next((t for t in discover_tvs() if t.get("kind") == tv["kind"] and t["serial"] == tv["serial"]
                      and t["ip"] != tv["ip"]), None)
        if moved:
            with lock:
                fresh = load()
                if (fresh.get("tv") or {}).get("serial") == tv["serial"]:
                    fresh["tv"]["ip"] = moved["ip"]
                    save(fresh)
            tv = {**tv, "ip": moved["ip"]}
            power = other_power(tv)
    return {**tv, "power": power} if power else None


def other_home(tv):
