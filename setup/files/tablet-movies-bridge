# ---- the TV's volume (web page), and a volume for each kind of video -------------------
#
# Plex is far quieter than YouTube (see "evening out loudness"), and on the TV
# only the TV's own volume can make up for it. So on an LG the bridge keeps a
# volume for each kind (Plex, Netflix, YouTube): whatever the TV was at while
# that kind played (turned with the remote or on the web page) is kept, and
# the next pick of that kind starts at it. A Roku has only volume buttons
# (no level to read or set), so there it's just − / + / mute.

TV_LEVELS = STATE / "tv-levels.json"  # {"enabled": bool, "plex": n, "netflix": n, "youtube": n}
LEVEL_KINDS = ("plex", "netflix", "youtube")
PICK_LEVEL_KIND = {"movie": "plex", "show": "plex", "netflix": "netflix", "dance": "youtube"}


def tv_levels():
    with side_lock:
        levels = read_side(TV_LEVELS)
    levels.setdefault("enabled", True)
    return levels


def set_tv_levels(change):
    with side_lock:
        levels = read_side(TV_LEVELS)
        levels.setdefault("enabled", True)
        if "enabled" in change:
            levels["enabled"] = bool(change["enabled"])
        for kind in LEVEL_KINDS:
            if kind in change:
                if change[kind] is None:
                    levels.pop(kind, None)
                elif isinstance(change[kind], int) and 0 <= change[kind] <= 100:
                    levels[kind] = change[kind]
                else:
                    raise ValueError("a volume is 0 to 100")
        write_side(TV_LEVELS, levels)
    return levels


def lg_learn_level(s, levels=None):
    """The LG's volume now is the one for what it's playing now (kept)."""
    try:
        kind = LG_APP_KINDS.get(s.foreground_app())
        level = s.volume()[0]
    except LGError:
        return None
    if kind and isinstance(level, int):
        with side_lock:
            known = read_side(TV_LEVELS)
            if known.get("enabled", True) and known.get(kind) != level:
                known[kind] = level
                write_side(TV_LEVELS, known)
                print(f"TV volume: {level} for {kind}", flush=True)
    return kind


def tv_level_before(cfg, pick_kind):
    """An LG, just before a pick starts: keep the volume of what's on now,
    then set the one this kind of video had last time (if it's known)."""
    kind = PICK_LEVEL_KIND.get(pick_kind)
    tv = cfg.get("tv") or {}
    if not kind or tv.get("kind") != "lg" or not tv_levels()["enabled"]:
        return
    try:
        with lg_session(tv) as s:
            lg_learn_level(s)
            want = tv_levels().get(kind)
            level = s.volume()[0]
            if isinstance(want, int) and want != level:
                s.set_volume(want)
                print(f"TV volume: {level} -> {want} for {kind}", flush=True)
    except OSError as e:  # never in the way of the pick
        print(f"TV volume: {e!r}", flush=True)


def tv_volume(change=None):
    """The TV's volume for the web page, changed first if asked: an LG takes
    {"level": 0-100} and {"mute": bool}; a Roku {"step": -5..5} and {"mute": true}
    (its mute button, which toggles)."""
    with lock:
        cfg = load()
    if not cfg.get("tv"):
        return {"ok": False, "message": "No TV is set up (choose one in Settings)."}
    tv = find_tv(cfg)
    if not tv:
        return {"ok": False, "message": "Can't find the TV on the network. Is it plugged in?"}
    kind = tv.get("kind") or "roku"
    if tv["power"] != "PowerOn":
        return {"ok": False, "kind": kind, "message": "The TV is off."}
    change = change or {}
    if kind in OTHER_TVS:
        return other_volume(tv, change)
    if kind == "lg":
        with lg_session(tv) as s:
            if "level" in change:
                level = change["level"]
                if not isinstance(level, int) or not 0 <= level <= 100:
                    raise ValueError("volume must be 0 to 100")
                s.set_volume(level)
            if "mute" in change:
                s.set_mute(bool(change["mute"]))
            level, muted, output = s.volume()
            playing = lg_learn_level(s) if "level" in change else LG_APP_KINDS.get(s.foreground_app())
        return {"ok": True, "kind": "lg", "control": "level", "level": level, "muted": muted, "output": output,
                "playing": playing}
    if change.get("mute"):
        roku_key(tv["ip"], "VolumeMute")
    step = int(change.get("step") or 0)
    for _ in range(min(abs(step), 5)):
        roku_key(tv["ip"], "VolumeUp" if step > 0 else "VolumeDown")
    return {"ok": True, "kind": "roku", "control": "buttons", "mute": True}


