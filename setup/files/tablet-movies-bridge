def tv_cli(args):
    """Testing the other kinds (run as tablet-movies):
         --tv discover            every TV the box can find (all kinds)
         --tv status              the chosen TV: power, what's on, pairings
         --tv pair <airplay|companion|remote|vizio>   type the code the TV shows
         --tv stop                its home screen"""
