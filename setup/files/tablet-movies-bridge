            raise TVError("pair the Apple TV's remote first")
        atv_json(tv, "launch", link)
    return True


def other_now(tv):
    """(app on screen, "play"/"pause"/...) as far as the TV says."""
    kind, ip = tv["kind"], tv["ip"]
    try:
        if kind in CAST_TVS:
            s = cast_json("status", ip, timeout=25)
            if not s.get("app") and kind == "googletv" and tv.get("remote"):
                app = remote_json(tv, "state").get("app")
                return ANDROID_TV_APPS.get(app, app), None
            return s.get("app"), s.get("state")
        if kind == "samsung":
            return samsung_now(tv)
        if kind == "firetv":
            app = firetv_app(ip)
            return ANDROID_TV_APPS.get(app, app), firetv_state(ip)
        if kind == "appletv" and tv.get("companion"):
            s = atv_json(tv, "state")
            return s.get("app"), s.get("state")
    except OSError as e:
        print(f"{TV_LABELS[kind]} now: {e}", flush=True)
    return None, None


def other_volume(tv, change):
    """Over Cast a level (0-100) and mute; otherwise volume buttons ({"step"}, {"mute": true})."""
    kind, ip = tv["kind"], tv["ip"]
    if kind in CAST_TVS:
        if "level" in change:
            level = change["level"]
            if not isinstance(level, int) or not 0 <= level <= 100:
                raise ValueError("volume must be 0 to 100")
            cast_json("volume", ip, str(level))
        if "mute" in change:
            cast_json("volume", ip, "mute" if change["mute"] else "unmute")
        s = cast_json("status", ip, timeout=25)
        return {"ok": True, "kind": kind, "control": "level", "level": s.get("volume"), "muted": s.get("muted")}
    step = max(-5, min(5, int(change.get("step") or 0)))
    if kind == "samsung":
        keys = (["KEY_MUTE"] if change.get("mute") else []) + ["KEY_VOLUP" if step > 0 else "KEY_VOLDOWN"] * abs(step)
        if keys:
            samsung_send(tv, *[{"method": "ms.remote.control", "params": {
                "Cmd": "Click", "DataOfCmd": k, "Option": "false", "TypeOfRemote": "SendRemoteKey"}} for k in keys])
    elif kind == "firetv":
        keys = (["KEYCODE_VOLUME_MUTE"] if change.get("mute") else []) + \
            ["KEYCODE_VOLUME_UP" if step > 0 else "KEYCODE_VOLUME_DOWN"] * abs(step)
        for k in keys:
            firetv_shell(ip, f"input keyevent {k}")
    elif kind == "appletv" and tv.get("companion"):
        for _ in range(abs(step)):
            atv_json(tv, "volume", "up" if step > 0 else "down")
    return {"ok": True, "kind": kind, "control": "buttons", "mute": kind != "appletv"}


def tv_player(tv, url):
    """How the bridge's own stream (Plex, Jellyfin) gets onto this TV: the
    helper command that plays and follows it, and its environment; None if
    it can't (not paired, or a kind that uses its own app)."""
    kind, ip = tv_kind(tv), (tv or {}).get("ip")
    if kind in CAST_TVS:
        return [CAST, "play", ip, url], {}
    if kind in ("lg", "samsung", "appletv") and tv.get("airplay"):
        return [AIRPLAY, "play", ip, url], {"TABLET_AIRPLAY_CREDENTIALS": tv["airplay"],
                                            "TABLET_AIRPLAY_MODE": "classic" if kind == "appletv" else "v2"}
    return None


def plex_from_start(is_playing, send):
    """Plex can resume despite the reset, and these TVs don't say where it is,
    so once it plays, jump to the start (a few seconds in, it's no harm)."""
    if wait_for(is_playing, 40):
        time.sleep(2)
        try:
            send("seekTo", {"type": "video", "offset": 0})
        except OSError as e:
            print(f"Plex seek to start: {e!r}", flush=True)


def firetv_plex_start(cfg, item, key, tv):
    """Plex on a Fire TV: its app, started over (like the Roku and the LG),
    the highlighted profile picked, then a Companion playMedia."""
    ip = tv["ip"]
    try:
        firetv_shell(ip, f"am force-stop {FIRETV_PLEX}")
        time.sleep(1)
        firetv_launch(ip, FIRETV_PLEX)
    except TVError as e:
        print(f"Fire TV Plex: {e}", flush=True)
        return {"result": "plex_closed", "message": "Plex isn't on the TV."}
    time.sleep(12)  # until "Who's watching?" is up
    if firetv_state(ip) not in ("play", "pause", "buffer"):
        firetv_shell(ip, "input keyevent KEYCODE_DPAD_CENTER")  # the highlighted (last-used) profile
    time.sleep(6)
    player = lg_plex_player(cfg, ip)
    if not player:
        return {"result": "plex_closed", "message": "Plex on the TV can't be reached."}
    send = player[1]
    params = plex_play_params(cfg, item, key)
    for attempt in range(2):
        send("playMedia", params)
        if wait_for(lambda: firetv_state(ip) in ("play", "buffer"), 20):
            break
        print("Fire TV: not playing 20s after asking; asking again", flush=True)
    else:
        return {"result": "error", "message": "The TV didn't start it."}
    threading.Thread(target=plex_from_start, args=(lambda: firetv_state(ip) == "play", send), daemon=True).start()
    return {"result": "playing", "message": "It's playing on the TV!"}


def other_start(cfg, item, key, tv):
