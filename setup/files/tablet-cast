#!/opt/kidsos-cast/bin/python3
"""Kids OS: Google TV / Android TV, Chromecast and Vizio TVs (the bridge's helper).

Its own venv (stage 36): pychromecast and androidtvremote2, pinned. Every command
prints JSON on stdout (pairing commands ask for the code on stderr and read it on
stdin, like tablet-airplay). Not yet tried on a real TV: built from the libraries'
and the TVs' documented protocols.

Cast (any TV or stick with Chromecast built-in: Google TV, Android TV, Chromecast,
most Vizio and many Sony, TCL, Hisense, Philips TVs):
  tablet-cast discover               the Cast devices on the network
  tablet-cast play <ip> <url>        plays an HLS stream in the Default Media Receiver;
                                     one JSON line per change ({"state", "position",
                                     "duration"}, finally {"end": "played"|"failed"|
                                     "stopped"}), like tablet-airplay; SIGTERM stops it
  tablet-cast youtube <ip> <id>...   the first video in YouTube, the rest queued after it
  tablet-cast status <ip>            {"app", "state", "volume", "muted"}
  tablet-cast stop <ip>              quits whatever app is casting
  tablet-cast volume <ip> <0-100|mute|unmute|up|down>

Google TV / Android TV remote (the TV's own remote protocol, as Google's TV remote
app uses it; certificate in $TABLET_CAST_CERTS, default /var/lib/tablet-movies/googletv):
  tablet-cast remote-pair <ip>       the TV shows a code; type it here
  tablet-cast remote <ip> state      {"on", "app"}
  tablet-cast remote <ip> key <KEYCODE_...|HOME|...>
  tablet-cast remote <ip> launch <link>   e.g. https://www.netflix.com/watch/<id>

Vizio SmartCast (its local API, port 7345 or 9000; token in $TABLET_VIZIO_TOKEN):
  tablet-cast vizio-pair <ip>        the TV shows a PIN; type it here; prints the token
  tablet-cast vizio <ip> power       {"on": bool}
  tablet-cast vizio <ip> key <HOME|VOL_UP|VOL_DOWN|MUTE_TOGGLE|BACK|OK>
"""
import asyncio
import json
import os
import signal
import socket
import ssl
import sys
import threading
import time
import urllib.request

CERTS = os.environ.get("TABLET_CAST_CERTS", "/var/lib/tablet-movies/googletv")
CLIENT_NAME = "Kids OS"
STARTUP_SECONDS = 60
VIZIO_KEYS = {"HOME": (4, 15), "BACK": (4, 0), "OK": (3, 2), "VOL_UP": (5, 1), "VOL_DOWN": (5, 0),
              "MUTE_TOGGLE": (5, 4), "PLAY": (2, 3), "PAUSE": (2, 2)}


def say(**fields):
    print(json.dumps(fields), flush=True)


# ---- Cast -------------------------------------------------------------------------------

def cast(ip, wait=12):
    import pychromecast
    cc = pychromecast.get_chromecast_from_host((ip, 8009, None, None, None), tries=2, timeout=wait)
    cc.wait(timeout=wait)
    return cc


def discover():
    import pychromecast
    found, browser = pychromecast.discovery.discover_chromecasts(timeout=4)
    browser.stop_discovery()
    out = []
    for info in found:
        if info.cast_type == "group":
            continue
        remote = False
        try:  # the Android TV remote service: a Google TV / Android TV, not just Cast
            socket.create_connection((info.host, 6466), timeout=1).close()
            remote = True
        except OSError:
            pass
        out.append({"ip": info.host, "name": info.friendly_name, "model": info.model_name,
                    "uuid": str(info.uuid), "manufacturer": info.manufacturer, "android_tv": remote})
    print(json.dumps(out))


def play(ip, url):
    cc = cast(ip)
    mc = cc.media_controller
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    mc.play_media(url, "application/x-mpegURL", title="Kids OS", stream_type="BUFFERED")
    try:
        mc.block_until_active(timeout=20)
    except Exception as e:  # the receiver didn't load
        say(end="failed", reason=repr(e)[:200])
        cc.disconnect()
        return
    started, last = False, None
    deadline = time.time() + STARTUP_SECONDS
    while not stop.is_set():
        stop.wait(1)
        try:
            mc.update_status()
        except Exception:
            pass
        st = mc.status
        state = {"PLAYING": "playing", "BUFFERING": "loading", "PAUSED": "paused"}.get(st.player_state, "idle")
        if state == "playing":
            started = True
        if state == "idle" and (started or st.idle_reason):
            reason = st.idle_reason or ""
            say(end="played" if reason == "FINISHED" else "failed" if reason == "ERROR" else "stopped",
                reason=reason.lower())
            cc.disconnect()
            return
        if not started and time.time() > deadline:
            say(end="failed", reason="never started")
            break
        now = (state, round(st.adjusted_current_time or 0, 1), round(st.duration or 0, 1))
        if now != last:
            say(state=now[0], position=now[1], duration=now[2])
            last = now
    else:
        say(end="stopped", reason="asked to stop")
    try:
        cc.quit_app()
    except Exception:
        pass
    cc.disconnect()


def youtube(ip, ids):
    from pychromecast.controllers.youtube import YouTubeController
    cc = cast(ip)
    yt = YouTubeController()
    cc.register_handler(yt)
    yt.play_video(ids[0])
    for vid in ids[1:]:
        yt.add_to_queue(vid)
    mc = cc.media_controller
    end = time.time() + 45
    while time.time() < end:
        time.sleep(1)
        if mc.status.player_state in ("PLAYING", "BUFFERING"):
            print(json.dumps({"playing": True}))
            cc.disconnect()
            return
    print(json.dumps({"playing": False}))
    cc.disconnect()
    raise SystemExit(1)


def status(ip):
    cc = cast(ip)
    mc = cc.media_controller
    time.sleep(1)
    st = cc.status
    print(json.dumps({"app": st.display_name if st and not cc.is_idle else None,
                      "state": {"PLAYING": "play", "PAUSED": "pause", "BUFFERING": "buffer"}.get(
                          mc.status.player_state),
                      "volume": round((st.volume_level or 0) * 100) if st else None,
                      "muted": bool(st and st.volume_muted)}))
    cc.disconnect()


def stop_app(ip):
    cc = cast(ip)
    if not cc.is_idle:
        cc.quit_app()
    print(json.dumps({"ok": True}))
    cc.disconnect()


def volume(ip, what):
    cc = cast(ip)
    if what == "mute":
        cc.set_volume_muted(True)
    elif what == "unmute":
        cc.set_volume_muted(False)
    elif what == "up":
        cc.volume_up(0.02)
    elif what == "down":
        cc.volume_down(0.02)
    else:
        cc.set_volume(max(0, min(100, int(what))) / 100)
    time.sleep(0.5)
    print(json.dumps({"volume": round((cc.status.volume_level or 0) * 100), "muted": bool(cc.status.volume_muted)}))
    cc.disconnect()


# ---- the Android TV remote protocol ------------------------------------------------------

def tv_remote(ip):
    from androidtvremote2 import AndroidTVRemote
    os.makedirs(CERTS, mode=0o700, exist_ok=True)
    return AndroidTVRemote(CLIENT_NAME, f"{CERTS}/cert.pem", f"{CERTS}/key.pem", ip)


async def remote_pair(ip):
    remote = tv_remote(ip)
    await remote.async_generate_cert_if_missing()
    await remote.async_start_pairing()
    print("Type the code (PIN) shown on the TV: ", end="", file=sys.stderr, flush=True)
    code = (await asyncio.get_running_loop().run_in_executor(None, sys.stdin.readline)).strip()
    await remote.async_finish_pairing(code)
    print("paired", flush=True)


async def remote(ip, command, arg=None):
    r = tv_remote(ip)
    await asyncio.wait_for(r.async_connect(), 15)
    try:
        if command == "state":
            for _ in range(20):  # the first updates arrive just after connecting
                if r.is_on is not None and r.current_app is not None:
                    break
                await asyncio.sleep(0.2)
            print(json.dumps({"on": r.is_on, "app": r.current_app}))
        elif command == "key":
            r.send_key_command(arg if arg.startswith("KEYCODE_") else f"KEYCODE_{arg}")
            await asyncio.sleep(0.5)
            print(json.dumps({"ok": True}))
        elif command == "launch":
            r.send_launch_app_command(arg)
            await asyncio.sleep(1)
            print(json.dumps({"ok": True}))
        else:
            raise SystemExit(__doc__)
    finally:
        r.disconnect()


# ---- Vizio SmartCast ---------------------------------------------------------------------

def vizio_call(ip, method, path, body=None, token=None):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE  # the TV's own self-signed certificate
    last = None
    for port in (7345, 9000):
        req = urllib.request.Request(f"https://{ip}:{port}{path}", method=method,
                                     data=json.dumps(body).encode() if body is not None else None,
                                     headers={"Content-Type": "application/json", **({"AUTH": token} if token else {})})
        try:
            with urllib.request.urlopen(req, timeout=8, context=ctx) as r:
                return json.loads(r.read() or b"{}")
        except OSError as e:
            last = e
    raise last


def vizio_pair(ip):
    device_id = "kidsos-" + socket.gethostname()
    start = vizio_call(ip, "PUT", "/pairing/start", {"DEVICE_ID": device_id, "DEVICE_NAME": CLIENT_NAME})
    item = start.get("ITEM") or {}
    print("Type the PIN shown on the TV: ", end="", file=sys.stderr, flush=True)
    pin = sys.stdin.readline().strip()
    done = vizio_call(ip, "PUT", "/pairing/pair", {
        "DEVICE_ID": device_id, "CHALLENGE_TYPE": item.get("CHALLENGE_TYPE", 1), "RESPONSE_VALUE": pin,
        "PAIRING_REQ_TOKEN": item.get("PAIRING_REQ_TOKEN", 0)})
    token = (done.get("ITEM") or {}).get("AUTH_TOKEN")
    if not token:
        raise SystemExit(f"pairing failed: {done.get('STATUS')}")
    print(token, flush=True)


def vizio(ip, command, arg=None):
    token = os.environ.get("TABLET_VIZIO_TOKEN")
    if command == "power":
        r = vizio_call(ip, "GET", "/state/device/power_mode", token=token)
        print(json.dumps({"on": bool((r.get("ITEMS") or [{}])[0].get("VALUE"))}))
    elif command == "key":
        codeset, code = VIZIO_KEYS[arg]
        vizio_call(ip, "PUT", "/key_command/", {"KEYLIST": [{"CODESET": codeset, "CODE": code, "ACTION": "KEYPRESS"}]},
                   token=token)
        print(json.dumps({"ok": True}))
    else:
        raise SystemExit(__doc__)


def main():
    a = sys.argv[1:]
    try:
        if a == ["discover"]:
            discover()
        elif len(a) == 3 and a[0] == "play":
            play(a[1], a[2])
        elif len(a) >= 3 and a[0] == "youtube":
            youtube(a[1], a[2:])
        elif len(a) == 2 and a[0] == "status":
            status(a[1])
        elif len(a) == 2 and a[0] == "stop":
            stop_app(a[1])
        elif len(a) == 3 and a[0] == "volume":
            volume(a[1], a[2])
        elif len(a) == 2 and a[0] == "remote-pair":
            asyncio.run(remote_pair(a[1]))
        elif len(a) >= 3 and a[0] == "remote":
            asyncio.run(remote(a[1], a[2], a[3] if len(a) > 3 else None))
        elif len(a) == 2 and a[0] == "vizio-pair":
            vizio_pair(a[1])
        elif len(a) >= 3 and a[0] == "vizio":
            vizio(a[1], a[2], a[3] if len(a) > 3 else None)
        else:
            raise SystemExit(__doc__)
    except SystemExit:
        raise
    except Exception as e:  # the bridge reads the reason
        print(json.dumps({"error": repr(e)[:300]}))
        raise SystemExit(2)


if __name__ == "__main__":
    main()
